# Optional heavy geospatial/BIM worker profile. Keep these native tools out of
# API and web images. Deploy this image against the existing engineering queue.
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv build-essential \
    gdal-bin python3-gdal grass-core pdal proj-bin \
    ca-certificates tini \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY services/engineering-worker/python/requirements-gis-bim.txt /tmp/requirements.txt
RUN python3 -m venv --system-site-packages /opt/gis-bim \
  && /opt/gis-bim/bin/pip install --no-cache-dir --upgrade pip \
  && /opt/gis-bim/bin/pip install --no-cache-dir -r /tmp/requirements.txt

COPY . .
RUN corepack enable \
  && pnpm install --frozen-lockfile \
  && pnpm --filter @kealee/engineering-worker... build
ENV PATH="/opt/gis-bim/bin:${PATH}"
ENV ENGINEERING_PYTHON=/opt/gis-bim/bin/python
ENV ENGINEERING_PROCESSOR=/app/services/engineering-worker/python/processor.py
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "services/engineering-worker/dist/index.js"]
