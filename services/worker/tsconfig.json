{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@kealee/ai": ["../../packages/ai/src/index.ts"],
      "@kealee/page-builder": ["../../packages/page-builder/src/index.ts"],
      "@kealee/realtime": ["../../packages/realtime/src/index.ts"],
      "@kealee/concept-engine": ["../../packages/concept-engine/src/index.ts"],
      "@kealee/storage": ["../../packages/storage/src/index.ts"],
      "@kealee/core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}