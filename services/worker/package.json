{
  "name": "@kealee/worker",
  "version": "1.0.0",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm --filter @kealee/database db:generate && tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@kealee/ai": "workspace:*",
    "@kealee/api": "workspace:*",
    "@kealee/communications": "workspace:*",
    "@kealee/concept-engine": "workspace:*",
    "@kealee/core": "workspace:*",
    "@kealee/database": "workspace:*",
    "@kealee/knowledge": "workspace:*",
    "@kealee/observability": "workspace:^",
    "@kealee/os-ai-orch": "workspace:*",
    "@kealee/page-builder": "workspace:*",
    "@kealee/pascal-agents": "workspace:*",
    "@kealee/queue": "workspace:*",
    "@kealee/realtime": "workspace:*",
    "@kealee/storage": "workspace:*",
    "@sentry/node": "^10.75.0",
    "bullmq": "^5.0.0",
    "ioredis": "^5.3.2",
    "node-cron": "^3.0.3",
    "openai": "^4.77.0",
    "pdfkit": "^0.20.2",
    "resend": "^6.28.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^1.2.0"
  }
}
