{
  "name": "kealee-platform",
  "version": "20.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "vercel-build": "NODE_OPTIONS=--max-old-space-size=6144 turbo run build --filter=portal-owner --filter=portal-contractor --filter=portal-developer --filter=os-admin --filter=m-project-owner --filter=m-marketplace --filter=m-ops-services --filter=m-permits-inspections --filter=m-architect --filter=m-finance-trust",
    "start": "cd services/api && node dist/index.js",
    "dev": "turbo run dev",
    "dev:portals": "concurrently --names \"owner,contractor,developer,cc,admin\" --prefix-colors \"cyan,magenta,yellow,green,blue\" \"pnpm --filter portal-owner dev\" \"pnpm --filter portal-contractor dev\" \"pnpm --filter portal-developer dev\" \"pnpm --filter command-center dev\" \"pnpm --filter os-admin dev\"",
    "dev:web": "pnpm --filter web-main dev",
    "build": "turbo run build",
    "seeds:build": "pnpm --filter @kealee/seeds build",
    "ensure:llm-deps": "node scripts/ensure-llm-deps-built.mjs",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "design:setup": "node scripts/setup-design-system.mjs",
    "design:components": "node scripts/generate-components.mjs",
    "design:themes": "node scripts/generate-themes.mjs",
    "design:all": "npm run design:setup && npm run design:components && npm run design:themes",
    "deploy": "bash scripts/deploy-all.sh",
    "deploy:api": "bash scripts/deploy-api.sh",
    "deploy:frontend": "bash scripts/deploy-frontend.sh",
    "setup:vercel": "bash scripts/setup-vercel.sh",
    "setup:railway": "bash scripts/setup-railway.sh",
    "verify": "bash scripts/verify-deployments.sh",
    "verify:vercel-supabase": "node scripts/verify-vercel-supabase-service-role.mjs",
    "db:push": "cd services/api && pnpm db:push",
    "db:seed": "cd services/api && pnpm db:seed",
    "db:migrate": "cd services/api && pnpm db:migrate",
    "db:studio": "cd services/api && pnpm db:studio",
    "setup": "bash scripts/run-all-setup.sh",
    "setup:storage": "bash scripts/setup-s3-r2-storage.sh",
    "setup:env": "bash scripts/setup-vercel-env-vars.sh",
    "setup:monitoring": "bash scripts/monitor-first-transactions.sh",
    "setup:alerts": "bash scripts/setup-alerts.sh",
    "ssl:diagnose": "bash scripts/ssl-diagnose.sh",
    "ssl:fix": "bash scripts/ssl-fix-trust-chain.sh",
    "ssl:test": "bash scripts/ssl-test-subdomains.sh",
    "ssl:setup-renewal": "bash scripts/ssl-setup-auto-renewal.sh",
    "ssl:fix-all": "bash scripts/ssl-complete-fix.sh",
    "test:unit": "jest --no-coverage",
    "test:integration": "bash scripts/test-integrations.sh",
    "test:api": "bash scripts/test-integrations.sh",
    "test:payment": "pnpm --dir apps/m-ops-services run test:payment",
    "test:upload": "bash scripts/test-file-upload.sh",
    "test:subscription": "pnpm --dir apps/m-ops-services run test:subscription",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:performance": "echo 'Performance tests not configured'",
    "test:smoke": "bash scripts/test-integrations.sh",
    "test:smoke:production": "API_URL=https://api.kealee.com bash scripts/test-integrations.sh",
    "test:permit": "bash scripts/test-permit-applications.sh",
    "test:load": "bash scripts/load-testing.sh",
    "test:security": "bash scripts/security-hardening.sh",
    "optimize:performance": "bash scripts/performance-optimization.sh",
    "setup:uat": "bash scripts/user-acceptance-testing.sh",
    "setup:docs": "bash scripts/documentation-setup.sh",
    "setup:marketing": "bash scripts/marketing-launch-prep.sh",
    "launch:parcel-marketing": "node scripts/launch-parcel-marketing.mjs",
    "seed:parcel-outreach": "node scripts/seed-parcel-outreach.mjs",
    "export:direct-mail": "node scripts/export-direct-mail-queue.mjs",
    "migrate:parcel-outreach": "node scripts/apply-supabase-sql.mjs packages/database/supabase/migrations/20260625_parcel_outreach.sql",
    "migrate:marketing-agency": "node scripts/apply-supabase-sql.mjs packages/database/supabase/migrations/20260701_marketing_agency_layer.sql",
    "migrate:intelligence-rls": "node scripts/apply-supabase-sql.mjs packages/database/supabase/migrations/20260702_intelligence_rls.sql",
    "migrate:marketing-email-campaigns": "node scripts/apply-supabase-sql.mjs packages/database/supabase/migrations/20260710_marketing_email_campaigns.sql",
    "provision:marketing-agency-users": "node scripts/provision-marketing-agency-users.mjs",
    "deploy:marketing-agency": "node scripts/deploy-marketing-agency.mjs",
    "deploy:marketing-agency:full": "node scripts/deploy-marketing-agency.mjs --provision-users",
    "generate:marketing-library": "tsx scripts/generate-marketing-library.ts",
    "backfill:marketing-channel": "node scripts/backfill-marketing-channel.mjs",
    "verify:owner-portal": "node scripts/verify-owner-portal-config.mjs",
    "smoke:premium-visuals": "node scripts/smoke-premium-addition-wholehome.mjs",
    "show:premium-deliverable": "node scripts/show-premium-deliverable.mjs",
    "sync:card-media:home": "pnpm --filter web-main run sync:card-media:home",
    "setup:seo": "bash scripts/seo-optimization.sh",
    "setup:content": "bash scripts/content-deployment.sh",
    "setup:golive": "bash scripts/go-live.sh",
    "setup:support": "bash scripts/support-team-training.sh",
    "launch:all": "bash scripts/execute-all-launch-tasks.sh",
    "deploy:staging": "bash scripts/deploy-staging.sh staging",
    "deploy:production": "bash scripts/deploy-production.sh",
    "deploy:all": "npm run deploy:staging && npm run test:smoke && npm run deploy:production",
    "railway:setup": "bash scripts/setup-railway-environments.sh",
    "railway:verify": "bash scripts/verify-railway-env-isolation.sh",
    "railway:deploy:staging": "bash scripts/deploy-api.sh staging",
    "railway:deploy:production": "bash scripts/deploy-api.sh production",
    "railway:migrate:staging": "bash scripts/railway-migrate.sh staging",
    "railway:migrate:production": "bash scripts/railway-migrate.sh production",
    "db:setup": "bash scripts/setup-dev-database.sh",
    "db:migrate:dev": "cd packages/database && npm run db:migrate:dev",
    "db:seed:legacy": "cd packages/database && npm run db:seed",
    "db:migrate:staging": "cd packages/database && npm run db:migrate:staging",
    "db:migrate:prod": "cd packages/database && npm run db:migrate:prod",
    "db:rollback:prod": "cd packages/database && npm run db:rollback:prod",
    "db:create:migration": "bash scripts/db-create-migration.sh",
    "go-live-check": "tsx scripts/go-live-check.ts",
    "v30:smoke": "node scripts/v30-smoke.mjs",
    "v30:test-concepts": "node scripts/v30-concept-scope-test.mjs",
    "v30:migrate": "cd packages/database && npx prisma migrate deploy",
    "v30:setup-check": "node scripts/v30-setup-check.mjs",
    "v30:prod-rollout": "node scripts/v30-prod-rollout.mjs",
    "v30:apply-env": "node scripts/apply-v30-env.mjs --resolve-user-id",
    "orchestrate:launch": "node scripts/orchestrate-launch.mjs",
    "orchestrate:launch+prep": "node scripts/orchestrate-launch.mjs --with-marketing-prep",
    "test:concept": "tsx scripts/test-concept-delivery.ts",
    "test:whole-home-premium-plus": "tsx scripts/test-whole-home-premium-plus.ts --engine-only",
    "platform-ai-test": "tsx scripts/platform-ai-test.ts",
    "automation-validation": "tsx scripts/automation-validation.ts",
    "production-deployment-check": "tsx scripts/production-deployment-check.ts",
    "platform:inventory": "node scripts/generate-workspace-inventory.mjs",
    "platform:verify-vercel-plan": "node scripts/verify-vercel-migration-config.mjs"
    ,"platform:provider-boundaries": "node scripts/check-provider-boundaries.mjs"
    ,"security:committed-secrets": "node scripts/check-committed-secrets.mjs"
    ,"platform:railway-catalog": "railway status --json | node scripts/verify-railway-service-catalog.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "bots/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "20.19.39",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/request": "2.48.13",
    "@types/serve-static": "1.15.10",
    "@types/three": "0.170.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.0.1",
    "dotenv": "^17.2.3",
    "ioredis": "^5.3.2",
    "isomorphic-dompurify": "^2.35.0",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.3.0",
    "tsx": "^4.21.0",
    "turbo": "^2.7.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@apollo/server": "^4.11.0",
    "@as-integrations/fastify": "^1.3.0",
    "@aws-sdk/client-s3": "^3.972.0",
    "@aws-sdk/s3-request-presigner": "^3.972.0",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/multipart": "^9.1.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^2.0.0",
    "@huggingface/transformers": "^3.8.1",
    "@kealee/observability": "workspace:^",
    "@sentry/nextjs": "^10.38.0",
    "@sentry/node": "^10.37.0",
    "@supabase/supabase-js": "^2.112.3",
    "axios": "^1.13.6",
    "bullmq": "^5.0.0",
    "csv-parse": "^6.2.1",
    "fastify": "^4.28.0",
    "fastify-raw-body": "^5.0.0",
    "graphql": "^16.12.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-tag": "^2.12.6",
    "next": "^14.2.35",
    "openai": "^6.32.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  },
  "overrides": {
    "@as-integrations/fastify": {
      "fastify": "^4.28.0"
    }
  }
}
