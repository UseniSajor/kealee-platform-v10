{
  "name": "@kealee/kealee-agent-stack",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./v30/*": {
      "types": "./src/v30/*.ts",
      "default": "./dist/v30/*.js"
    }
  },
  "scripts": {
    "build": "tsc --incremental false",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "openai": "^6.32.0",
    "replicate": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "20.19.39",
    "typescript": "^5.9.3"
  }
}
