{
  "name": "@kealee/core-llm",
  "version": "1.0.0",
  "private": true,
  "description": "Kealee internal-first LLM stack: provider registry, router, retrieval, logging",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./analytics/growth-queries": {
      "require": "./dist/analytics/growth-queries.js",
      "import": "./dist/analytics/growth-queries.js",
      "types": "./dist/analytics/growth-queries.d.ts"
    },
    "./analytics/growth-tracker": {
      "require": "./dist/analytics/growth-tracker.js",
      "import": "./dist/analytics/growth-tracker.js",
      "types": "./dist/analytics/growth-tracker.d.ts"
    },
    "./bots/design-bot-enterprise": {
      "require": "./dist/bots/design-bot-enterprise.js",
      "import": "./dist/bots/design-bot-enterprise.js",
      "types": "./dist/bots/design-bot-enterprise.d.ts"
    },
    "./bots/estimate-bot-enterprise": {
      "require": "./dist/bots/estimate-bot-enterprise.js",
      "import": "./dist/bots/estimate-bot-enterprise.js",
      "types": "./dist/bots/estimate-bot-enterprise.d.ts"
    },
    "./bots/permit-bot-enterprise": {
      "require": "./dist/bots/permit-bot-enterprise.js",
      "import": "./dist/bots/permit-bot-enterprise.js",
      "types": "./dist/bots/permit-bot-enterprise.d.ts"
    },
    "./bots/floorplan-bot-enterprise": {
      "require": "./dist/bots/floorplan-bot-enterprise.js",
      "import": "./dist/bots/floorplan-bot-enterprise.js",
      "types": "./dist/bots/floorplan-bot-enterprise.d.ts"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @kealee/seeds build",
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@kealee/database": "workspace:*",
    "@kealee/core-agents": "workspace:*",
    "@kealee/seeds": "workspace:*",
    "bottleneck": "^2.19.5",
    "openai": "^4.77.0",
    "zod": "^3.22.4",
    "nanoid": "^3.3.7",
    "csv-parse": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
