// Agent Session model
// Stores runtime state for autonomous agents and keacore
// Auto-generated by Kealee core-agents

model AgentSession {
  id        String    @id @default(uuid())
  orgId     String?
  userId    String?
  projectId String?
  threadId  String?
  source    String    // web, portal-owner, etc.
  mode      String    // autonomous, assisted, operator
  status    String    // active, paused, closed
  memory    Json
  metadata  Json?
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([orgId])
  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@map("agent_sessions")
}
