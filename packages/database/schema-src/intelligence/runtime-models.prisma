// Runtime models restored after the v30 schema split removed delegates that
// remain in active API paths and production tables.

enum LeadStage {
  UNKNOWN
  AWARENESS
  CONCEPT
  DESIGN
  PERMIT
  ESTIMATION
  CHECKOUT
  HOT
}

enum ReadinessState {
  NOT_READY
  NEEDS_MORE_INFO
  READY_FOR_CONCEPT
  READY_FOR_ZONING_REVIEW
  READY_FOR_ESTIMATE
  READY_FOR_PERMIT_REVIEW
  READY_FOR_CHECKOUT
  PERMIT_SUBMITTED
  PERMIT_APPROVED
  REQUIRES_CONSULTATION
  BLOCKED
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  type        String
  url         String
  prompt      String?
  style       String?
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
  @@index([style])
}

model LeadProfile {
  id                       String    @id @default(cuid())
  email                    String?   @unique
  phone                    String?
  firstName                String?
  lastName                 String?
  projectType              String?
  location                 String?
  budgetRange              String?
  hasPlans                 Boolean?
  needsPermit              Boolean?
  urgencyLevel             String?   @default("normal")
  stage                    LeadStage @default(UNKNOWN)
  leadScore                Int       @default(0)
  source                   String?
  contractorMatchCandidate Boolean   @default(false)
  lastActivityAt           DateTime  @default(now())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@map("lead_profiles")
  @@index([email])
  @@index([stage])
  @@index([leadScore])
  @@index([createdAt])
}

model KeaBotEvent {
  id            String    @id @default(uuid())
  projectId     String?
  sessionId     String?
  eventType     String
  payload       Json      @default("{}")
  context       Json?
  triggeredBots String[]
  executionPlan Json?
  status        String    @default("pending")
  errors        Json?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@map("keabot_events")
  @@index([projectId])
  @@index([sessionId])
  @@index([eventType])
  @@index([status])
}

model ZoningIntake {
  id              String    @id @default(uuid())
  conceptIntakeId String?
  projectAddress  String?
  projectType     String?
  description     String?   @db.Text
  zipCode         String?
  status          String    @default("new")
  paidAt          DateTime?
  metadata        Json?
  funnelSessionId String?
  source          String    @default("WEBSITE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@map("zoning_intakes")
}

model EstimationIntake {
  id              String    @id @default(uuid())
  relatedZoningId String?
  projectAddress  String?
  projectType     String?
  description     String?   @db.Text
  zipCode         String?
  status          String    @default("new")
  paidAt          DateTime?
  metadata        Json?
  funnelSessionId String?
  source          String    @default("WEBSITE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@map("estimation_intakes")
}

model PermitIntake {
  id                String    @id @default(uuid())
  relatedEstimateId String?
  projectAddress    String?
  projectType       String?
  description       String?   @db.Text
  zipCode           String?
  status            String    @default("new")
  paidAt            DateTime?
  metadata          Json?
  funnelSessionId   String?
  source            String    @default("WEBSITE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@map("permit_intakes")
}

model ServiceChainGate {
  id                         String         @id @default(uuid())
  projectId                  String?        @unique
  userId                     String?
  conceptCompleted           Boolean        @default(false)
  conceptIntakeId            String?
  zoningCompleted            Boolean        @default(false)
  zoningIntakeId             String?
  estimationCompleted        Boolean        @default(false)
  estimationIntakeId         String?
  permitReadyForCheckout     Boolean        @default(false)
  permitIntakeId             String?
  permitSubmitted            Boolean        @default(false)
  permitApproved             Boolean        @default(false)
  noPermitRequired           Boolean        @default(false)
  contractorMatchingUnlocked Boolean        @default(false)
  currentReadinessState      ReadinessState @default(NOT_READY)
  nextRequiredService        String?
  blockedReason              String?
  lastServiceCompleted       String?
  chain                      Json?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  @@map("service_chain_gates")
  @@index([projectId])
  @@index([userId])
  @@index([currentReadinessState])
}

model ConversionFunnel {
  id                  String    @id @default(uuid())
  funnelSessionId     String    @unique
  userId              String?
  source              String?
  campaign            String?
  medium              String?
  events              Json      @default("[]")
  eventTimestamps     Json      @default("{}")
  conceptCompleted    Boolean   @default(false)
  zoningCompleted     Boolean   @default(false)
  estimationCompleted Boolean   @default(false)
  permitCompleted     Boolean   @default(false)
  fullChainCompleted  Boolean   @default(false)
  totalRevenue        Int       @default(0)
  firstEventAt        DateTime?
  lastEventAt         DateTime?
  completionTime      Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("conversion_funnels")
  @@index([funnelSessionId])
  @@index([userId])
  @@index([source])
  @@index([fullChainCompleted])
}

model V30BotConfiguration {
  id             String   @id @default(uuid())
  botType        String   @unique
  systemPrompt   String   @db.Text
  modelPrimary   String   @default("claude-sonnet-4-5")
  modelSecondary String   @default("gpt-4o")
  modelFallback  String   @default("claude-sonnet-4-5")
  temperature    Float    @default(0.7)
  maxTokens      Int      @default(2000)
  topP           Float    @default(0.9)
  timeoutSeconds Int      @default(60)
  retryOnFailure Boolean  @default(true)
  maxRetries     Int      @default(3)
  maxCostUSD     Decimal? @db.Decimal(10, 2)
  costThreshold  Decimal? @db.Decimal(10, 2)
  version        Int      @default(1)
  notes          String?
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("v30_bot_configurations")
}
