
model ProjectTwin {
  id             String  @id @default(uuid())
  orgId          String?
  projectId      String? @unique
  propertyTwinId String?
  leadTwinId     String?
  intakeLeadId   String?

  name           String?
  scope          Json?
  budget         Decimal? @db.Decimal(14, 2)
  estimateTotal  Decimal? @db.Decimal(14, 2)
  permitStatus   String?
  projectPhase   String?
  healthScore    Float    @default(0)
  missingItems   String[] @default([])
  riskFlags      String[] @default([])
  metrics        Json?
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyTwin PropertyTwin? @relation(fields: [propertyTwinId], references: [id], onDelete: SetNull)
  leadTwin     LeadTwin?     @relation(fields: [leadTwinId], references: [id], onDelete: SetNull)
  capitalTwins CapitalTwin[]
  loopRuns     LoopRun[]
  decisions    ProjectDecision[]
  intelligenceRuns IntelligenceRun[]

  @@index([orgId])
  @@index([propertyTwinId])
  @@index([leadTwinId])
  @@index([healthScore])
  @@map("project_twins")
}

model CapitalTwin {
  id             String  @id @default(uuid())
  orgId          String?
  projectTwinId  String?
  propertyTwinId String?
  leadTwinId     String?

  estimatedPropertyValue Decimal? @db.Decimal(14, 2)
  estimatedMortgageBalance Decimal? @db.Decimal(14, 2)
  estimatedEquity        Decimal? @db.Decimal(14, 2)
  estimatedLTV           Float?
  projectBudget          Decimal? @db.Decimal(14, 2)
  capitalFitScore        Float    @default(0)
  recommendedLoanProducts String[] @default([])
  fundingGap             Decimal? @db.Decimal(14, 2)
  requiredDocuments      String[] @default([])
  lenderRouting          String?
  riskFlags              String[] @default([])
  complianceFlags        String[] @default([])
  consentFinancing       Boolean  @default(false)
  metadata               Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectTwin  ProjectTwin?  @relation(fields: [projectTwinId], references: [id], onDelete: SetNull)
  propertyTwin PropertyTwin? @relation(fields: [propertyTwinId], references: [id], onDelete: SetNull)
  leadTwin     LeadTwin?     @relation(fields: [leadTwinId], references: [id], onDelete: SetNull)
  loopRuns     LoopRun[]
  intelligenceRuns IntelligenceRun[]

  @@index([projectTwinId])
  @@index([propertyTwinId])
  @@index([leadTwinId])
  @@index([capitalFitScore])
  @@map("capital_twins")
}

model IntelligenceRun {
  id               String                  @id @default(uuid())
  engineType       IntelligenceEngineType
  loopRunId        String?
  projectId        String?
  propertyTwinId   String?
  leadTwinId       String?
  capitalTwinId    String?
  projectTwinId    String?
  triggerEvent     String
  triggerEventId   String?
  inputSnapshot    Json
  outputSnapshot   Json
  confidenceScore  Float
  requiresHumanReview Boolean              @default(false)
  reviewReasons    String[]                @default([])
  agentId          String?

  createdAt DateTime @default(now())

  loopRun      LoopRun?      @relation(fields: [loopRunId], references: [id], onDelete: SetNull)
  propertyTwin PropertyTwin? @relation(fields: [propertyTwinId], references: [id], onDelete: SetNull)
  leadTwin     LeadTwin?     @relation(fields: [leadTwinId], references: [id], onDelete: SetNull)
  capitalTwin  CapitalTwin?  @relation(fields: [capitalTwinId], references: [id], onDelete: SetNull)
  projectTwin  ProjectTwin?  @relation(fields: [projectTwinId], references: [id], onDelete: SetNull)

  @@index([engineType])
  @@index([triggerEvent])
  @@index([propertyTwinId])
  @@index([leadTwinId])
  @@index([projectTwinId])
  @@map("intelligence_runs")
}

model ProjectDecision {
  id            String  @id @default(uuid())
  projectTwinId String
  loopRunId     String?
  decisionType  String
  title         String
  context       Json?
  recommendation String? @db.Text
  status        String  @default("pending")
  decidedBy     String?
  decidedAt     DateTime?
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectTwin ProjectTwin @relation(fields: [projectTwinId], references: [id], onDelete: Cascade)

  @@index([projectTwinId])
  @@index([status])
  @@map("project_decisions")
}
