// ─────────────────────────────────────────────────────────────────────────────
// Retrieval corpus — Phase G of docs/decisions/toolchain-self-sufficiency.md
//
// The retriever and vector store in `packages/ai/src/rag` have existed for
// months with NO TABLES BEHIND THEM, and their only ingester lives in
// `services/api`, which is not in the Railway production list. So nothing has
// ever been ingested and nothing has ever been retrieved.
//
// Embeddings are FLOAT8[] with cosine similarity computed in SQL. No pgvector:
// the corpus is thousands of chunks, not millions, and a dependency on a
// Postgres extension the host may not offer is a Ring-3 risk for no gain.
//
// TENANCY: every row is tenant-scoped and there is no nullable escape hatch.
// This corpus exists to carry one job's findings into the next, so an unscoped
// row is not a latent bug — it is cross-tenant leakage working as designed. A
// homeowner's property or a professional's judgement must never surface in
// another tenant's workspace, and the homeowner business and the white-label
// tenants are on opposite sides of that line (docs/decisions/white-label-and-
// tenancy.md). Scoped here BEFORE the tables exist in any database, which is
// the only moment it costs nothing.
//
// PERSONAL DATA: nothing enters these tables that has not passed
// `admitToCorpus()` in @kealee/knowledge. Customer names, emails and street
// addresses are dropped at the boundary; order ids are hashed. See
// packages/knowledge/src/policies/personal-data.ts for the field policy and
// the retention rules that govern erasure.
// ─────────────────────────────────────────────────────────────────────────────

model RagDocument {
  id          String   @id @default(cuid())
  /// Owning tenant. Required — retrieval is partitioned on it.
  tenantId    String
  sourceType  String
  sourceId    String
  title       String
  content     String   @db.Text

  // Retrieval filters. Jurisdiction and serviceType are what make a hit
  // relevant; a redline from another county is noise.
  jurisdiction String?
  serviceType  String?
  phase        String?
  projectId    String?

  chunkCount   Int      @default(0)
  lastIndexed  DateTime?

  // ── Provenance and governance ──
  // Which embedding model produced this document's chunks. A re-embed under a
  // new model writes a NEW version rather than mutating these rows, so the
  // index is never half in one vector space and half in another.
  embeddingModel   String
  embeddingVersion Int     @default(1)
  embeddingDims    Int
  // Authority of the underlying material, mirroring KnowledgeArtifact. A
  // retrieval that cannot say where a fact came from cannot be used to ground
  // a drawing.
  authority        String?
  knowledgeArtifactId String?
  // True once `admitToCorpus()` has run over the source record.
  personalDataScreened Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chunks      RagChunk[]

  // Uniqueness is PER TENANT: two tenants may legitimately hold a document
  // about the same public parcel, and neither may see the other's.
  @@unique([tenantId, sourceType, sourceId, embeddingVersion])
  @@index([tenantId, jurisdiction, serviceType])
  @@index([tenantId, projectId])
  @@index([embeddingModel, embeddingVersion])
  @@map("rag_documents")
}

model RagChunk {
  id          String   @id @default(cuid())
  /// Denormalised from the parent document so a similarity scan can filter on
  /// the tenant WITHOUT joining. The join is the thing most likely to be
  /// forgotten in a hand-written similarity query, and forgetting it here
  /// returns another tenant's chunks.
  tenantId    String
  documentId  String
  chunkIndex  Int
  content     String   @db.Text
  // Cosine similarity is computed over this in SQL.
  embedding   Float[]
  tokenCount  Int      @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())

  document    RagDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([tenantId])
  @@map("rag_chunks")
}

// A retrieval that actually happened, recorded so a generated output can name
// the evidence it was grounded on. Without this, "the model used the corpus"
// is an assertion nobody can check.
model RagRetrieval {
  id            String   @id @default(cuid())
  tenantId      String
  query         String   @db.Text
  filters       Json?
  /// Chunk ids returned, in rank order, with their scores.
  hits          Json
  topScore      Float?
  generationRunId String?
  orderId       String?
  workflowId    String?
  embeddingModel String
  createdAt     DateTime @default(now())

  @@index([generationRunId])
  @@index([workflowId])
  @@index([tenantId, createdAt])
  @@map("rag_retrievals")
}
