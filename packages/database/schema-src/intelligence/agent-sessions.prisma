model AgentSession {
  id        String    @id @default(uuid())
  orgId     String?
  userId    String?
  projectId String?
  threadId  String?
  source    String
  mode      String    @default("assisted")
  status    String    @default("active")
  memory    Json      @default("{}")
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@map("agent_sessions")
}

model BotPrompt {
  id          String   @id @default(cuid())
  botName     String
  promptType  String
  version     Int      @default(1)
  content     String   @db.Text
  variables   Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([botName, version])
  @@index([botName])
  @@index([isActive])
  @@map("bot_prompts")
}

model KeabotEvent {
  id            String    @id @default(cuid())
  projectId     String?
  sessionId     String?
  eventType     String
  payload       Json      @default("{}")
  context       Json?
  triggeredBots String[]  @default([])
  executionPlan Json?
  status        String    @default("pending")
  errors        Json?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([projectId])
  @@index([sessionId])
  @@index([eventType])
  @@index([status])
  @@map("keabot_events")
}
