// AI communications, sales/support, jurisdiction, and site-plan workflow records.
// These records reference canonical entities by scalar ID to avoid duplicating ownership.

enum AiCommunicationChannel {
  VOICE
  SMS
  WHATSAPP
  EMAIL
  WEB_CHAT
  PORTAL_CHAT
}

enum AiCommunicationSessionStatus {
  PENDING
  ACTIVE
  TRANSFERRING
  COMPLETED
  FAILED
  REDACTED
}

enum SupportCaseStatus {
  OPEN
  AUTHENTICATING
  INVESTIGATING
  WAITING_CUSTOMER
  WAITING_STAFF
  ESCALATED
  RESOLVED
  CLOSED
}

enum SitePlanStageCode {
  PARCEL_RESOLUTION
  DOCUMENT_COLLECTION
  FEASIBILITY
  PLAN_GENERATION
  COMPLIANCE_AUDIT
  PROFESSIONAL_REVIEW
  SUBMISSION_CORRECTIONS
}

enum SitePlanStageStatus {
  NOT_STARTED
  READY
  IN_PROGRESS
  BLOCKED
  AWAITING_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum ComplianceOutcome {
  PASS
  WARNING
  FAIL
  NOT_APPLICABLE
  MISSING_DATA
  PROFESSIONAL_DETERMINATION_REQUIRED
}

enum ProfessionalReviewDecision {
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUPERSEDED
}

model AiCommunicationSession {
  id                String                       @id @default(uuid())
  organizationId    String?
  contactId         String?
  leadId            String?
  projectId         String?
  provider          String
  providerSessionId String?                      @unique
  channel           AiCommunicationChannel
  direction         String
  status            AiCommunicationSessionStatus @default(PENDING)
  locale            String                       @default("en-US")
  consentId         String?
  disclosureVersion String?
  recordingEnabled  Boolean                      @default(false)
  retentionUntil    DateTime?
  startedAt         DateTime?
  endedAt           DateTime?
  metadata          Json?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@index([organizationId, createdAt])
  @@index([contactId, createdAt])
  @@index([projectId, createdAt])
  @@index([status, createdAt])
  @@map("ai_communication_sessions")
}

model AiConversationArtifact {
  id             String   @id @default(uuid())
  sessionId      String
  artifactType   String
  encryptedBody  String?  @db.Text
  redactedBody   String?  @db.Text
  storageUrl     String?
  encryptionKeyId String?
  contentHash    String
  model          String?
  confidence     Decimal? @db.Decimal(5, 4)
  metadata       Json?
  createdAt      DateTime @default(now())

  @@unique([sessionId, artifactType, contentHash])
  @@index([sessionId, createdAt])
  @@map("ai_conversation_artifacts")
}

model AiSalesWorkflow {
  id                String   @id @default(uuid())
  organizationId    String
  contactId         String?
  leadId             String?
  projectId          String?
  state              String   @default("NEW")
  completedSteps     String[] @default([])
  appliedEventIds    String[] @default([])
  version            Int      @default(0)
  humanOwnerId       String?
  stoppedAt          DateTime?
  stopReason         String?
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([organizationId, state, updatedAt])
  @@index([leadId])
  @@index([projectId])
  @@map("ai_sales_workflows")
}

model CustomerSupportCase {
  id               String            @id @default(uuid())
  organizationId   String
  contactId        String?
  projectId        String?
  sessionId        String?
  status           SupportCaseStatus @default(OPEN)
  topic            String
  urgency          String
  sentiment        String?
  confidence       Decimal?          @db.Decimal(5, 4)
  assignedToUserId String?
  slaDueAt         DateTime?
  resolutionCriteria String?         @db.Text
  resolvedAt       DateTime?
  closedAt         DateTime?
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([organizationId, status, slaDueAt])
  @@index([projectId, createdAt])
  @@index([assignedToUserId, status])
  @@map("customer_support_cases")
}

model JurisdictionRuleVersion {
  id                  String   @id @default(uuid())
  jurisdictionCode    String
  agency               String
  ruleKey              String
  version              Int
  projectTypes         String[] @default([])
  permitTypes          String[] @default([])
  applicability        Json
  requirements         Json
  sourceUrl             String
  sourceTitle           String
  effectiveDate         DateTime?
  lastVerifiedAt        DateTime
  supersededAt          DateTime?
  confidence            Decimal @db.Decimal(5, 4)
  humanReviewRequired   Boolean @default(false)
  createdAt             DateTime @default(now())

  @@unique([jurisdictionCode, ruleKey, version])
  @@index([jurisdictionCode, supersededAt])
  @@index([agency])
  @@map("jurisdiction_rule_versions")
}

model SitePlanWorkflow {
  id               String   @id @default(uuid())
  organizationId   String
  projectId         String
  propertyId        String?
  parcelId          String?
  productId         String?
  currentStage      SitePlanStageCode @default(PARCEL_RESOLUTION)
  status            String   @default("ACTIVE")
  version           Int      @default(0)
  professionalReviewRequired Boolean @default(true)
  releasedAt        DateTime?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([organizationId, projectId])
  @@index([organizationId, status, updatedAt])
  @@map("site_plan_workflows")
}

model SitePlanStageExecution {
  id              String              @id @default(uuid())
  workflowId      String
  stage           SitePlanStageCode
  status          SitePlanStageStatus @default(NOT_STARTED)
  attempt         Int                 @default(1)
  prerequisites   Json
  inputs          Json?
  outputs         Json?
  blockers        Json?
  assignedPartyId String?
  startedAt       DateTime?
  completedAt     DateTime?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([workflowId, stage, attempt])
  @@index([workflowId, stage, status])
  @@index([status, updatedAt])
  @@map("site_plan_stage_executions")
}

model SitePlanComplianceResult {
  id                    String            @id @default(uuid())
  workflowId            String
  stageExecutionId      String
  ruleVersionId         String
  outcome               ComplianceOutcome
  inputs                Json
  result                Json
  remediation           String?           @db.Text
  responsibleDiscipline String?
  blocksSubmission      Boolean            @default(false)
  calculationVersion    String?
  confidence            Decimal            @db.Decimal(5, 4)
  createdAt             DateTime           @default(now())

  @@unique([stageExecutionId, ruleVersionId])
  @@index([workflowId, outcome])
  @@index([blocksSubmission, createdAt])
  @@map("site_plan_compliance_results")
}

model ProfessionalReviewRecord {
  id                       String                     @id @default(uuid())
  workflowId               String
  professionalAssignmentId String
  jurisdictionCode         String
  discipline               String
  licenseNumber            String
  licenseVerifiedAt        DateTime?
  decision                 ProfessionalReviewDecision @default(PENDING)
  sourceDocumentId         String?
  sealedDocumentId         String?
  sourceContentHash        String?
  sealedContentHash        String?
  declaration              String?                    @db.Text
  decidedAt                DateTime?
  expiresAt                DateTime?
  metadata                 Json?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@index([workflowId, decision])
  @@index([professionalAssignmentId])
  @@map("professional_review_records")
}

model PermitCorrectionCycle {
  id                  String   @id @default(uuid())
  workflowId          String
  permitId            String?
  submissionId        String?
  cycleNumber         Int
  agencyReference     String?
  commentsDocumentId  String?
  comments            Json
  assignments         Json
  responseLetterId    String?
  resubmissionEvidence Json?
  status              String   @default("OPEN")
  submittedAt         DateTime?
  closedAt            DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([workflowId, cycleNumber])
  @@index([workflowId, status])
  @@map("permit_correction_cycles")
}
