// WORKFLOW — Loops Orchestration Models
// Kealee Platform v30 Loop Orchestration System

model LoopRun {
  id              String     @id @default(cuid())
  projectId       String
  loopType        String     // intake_refinement, estimate_revision, permit_correction, contractor_bid, etc.
  status          String     // PENDING, RUNNING, COMPLETED, FAILED, AWAITING_REVIEW
  currentStep     String?
  confidenceScore Float?
  requiresReview  Boolean    @default(false)
  triggerEvent    String     // PROJECT_CREATED, INTAKE_UPDATED, etc.
  inputSnapshot   Json?      // Input payload
  outputSnapshot  Json?      // Structured output response
  nextAction      Json?      // Planned next steps
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  steps           LoopStep[]
  project         Project    @relation("ProjectLoopRuns", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([loopType])
  @@index([status])
  @@index([createdAt])
  @@map("loop_runs")
}

model LoopStep {
  id              String   @id @default(cuid())
  loopRunId       String
  agentName       String   // OwnerAgent, IntakeAgent, etc.
  stepType        String   // evaluation, revision, check, etc.
  input           Json?
  output          Json?
  confidenceScore Float?
  error           String?  @db.Text
  createdAt       DateTime @default(now())

  // Relations
  loopRun         LoopRun  @relation(fields: [loopRunId], references: [id], onDelete: Cascade)

  @@index([loopRunId])
  @@index([createdAt])
  @@map("loop_steps")
}

model ProjectDecision {
  id              String   @id @default(cuid())
  projectId       String
  loopRunId       String?
  decisionType    String   // select_concept, value_engineer, authorize_filing, etc.
  selectedOption  String
  reason          String?  @db.Text
  budgetImpact    Float?
  scheduleImpact  String?
  createdBy       String?  // user ID
  createdAt       DateTime @default(now())

  // Relations
  project         Project  @relation("ProjectDecisions", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([loopRunId])
  @@index([createdAt])
  @@map("project_decisions")
}

model AgentMemory {
  id          String   @id @default(cuid())
  projectId   String
  agentName   String   // IntakeAgent, EstimateAgent, etc.
  memoryType  String   // project_context, user_preferences, historical_choices, etc.
  content     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project         Project  @relation("ProjectAgentMemory", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([agentName])
  @@index([updatedAt])
  @@map("agent_memories")
}

model V30PricingFormula {
  id                 String   @id @default(uuid())
  baseAmount         Float
  sqftMultiplier     Float
  complexityFees     Json     // Record<string, number>
  featureCosts       Json     // Record<string, number>
  urgencyMultiplier  Float
  locationMultiplier Float
  minPrice           Float
  maxPrice           Float
  active             Boolean  @default(true)
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("v30_pricing_formulas")
}

model AutomationEvent {
  id            String   @id @default(cuid())
  projectId     String
  eventName     String   // PROJECT_CREATED, INTAKE_UPDATED, etc.
  payload       Json
  processed     Boolean  @default(false)
  error         String?  @db.Text
  createdAt     DateTime @default(now())

  // Relations
  project       Project  @relation("ProjectAutomationEvents", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([eventName])
  @@index([createdAt])
  @@map("automation_events")
}

model V30WhiteLabelConfig {
  id                  String   @id @default(cuid())
  partnerId           String   @unique
  companyName         String
  companyEmail        String
  logoUrl             String?
  primaryColor        String   @default("#0064C8")
  secondaryColor      String   @default("#666666")
  accentColor         String   @default("#00B050")
  customDomain        String?
  enabledFeatures     String[] @default(["design", "estimate"])
  monthlyProjectLimit Int?
  teamSizeLimit       Int?
  markup              Float    @default(1)
  customPricing       Json?
  webhookUrl          String?
  webhookSecret       String?
  supportEmail        String?
  supportPhone        String?
  status              String   @default("ACTIVE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("v30_white_label_configs")
}

model V30IntakeResponse {
  id                 String             @id @default(cuid())
  projectId          String             @unique
  userId             String
  propertyType       String
  primaryScope       String
  budgetRange        String
  timeline           String
  location           String
  squareFeet         Int
  yearBuilt          String
  utilities          Json               @default("{}")
  codeConsiderations String[]           @default([])
  scopeComplexity    String
  riskLevel          String
  estimatedCost      Decimal            @db.Decimal(12, 2)
  estimatedDays      Int
  analysisJson       Json               @default("{}")
  status             String             @default("SUBMITTED")
  analyzedAt         DateTime?
  expiresAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  customPackage      V30CustomPackage?

  @@map("v30_intake_responses")
}

model V30CustomPackage {
  id               String            @id @default(cuid())
  intakeResponseId String            @unique
  projectId        String            @unique
  userId           String
  features         String[]          @default([])
  basePrice        Decimal           @db.Decimal(12, 2)
  featureAddons    Decimal           @default(0) @db.Decimal(12, 2)
  totalPrice       Decimal           @db.Decimal(12, 2)
  stripeProductId  String?
  stripePriceId    String?
  stripeSessionId  String?
  status           String            @default("DRAFT")
  acceptedAt       DateTime?
  paidAt           DateTime?
  completedAt      DateTime?
  expiresAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  intakeResponse   V30IntakeResponse @relation(fields: [intakeResponseId], references: [id], onDelete: Cascade)

  @@map("v30_custom_packages")
}

model V30BotExecution {
  id           String    @id @default(cuid())
  projectId    String
  packageId    String
  botType      String
  status       String    @default("PENDING")
  progress     Int       @default(0)
  inputData    Json?
  outputData   Json?
  modelUsed    String?
  tokensUsed   Int?
  costUSD      Float?
  durationMs   Int?
  errorMessage String?   @db.Text
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("v30_bot_executions")
}

model V30BotResult {
  id             String   @id @default(cuid())
  executionId    String   @unique
  resultType     String   @default("json")
  contentJson    Json
  deliveredAt    DateTime @default(now())
  deliveryMethod String   @default("api")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("v30_bot_results")
}

