// Canonical Hermes + Claw grade autonomous runtime.
// Provider-neutral: existing V30 bots, Claw workers, humans, and external agents
// register as capabilities and execute against the same durable run ledger.

enum AutonomousGoalStatus {
  DRAFT
  READY
  ACTIVE
  PAUSED
  BLOCKED
  COMPLETE
  CANCELLED
  FAILED
}

enum AutonomousRunStatus {
  QUEUED
  PLANNING
  RUNNING
  AWAITING_INPUT
  AWAITING_APPROVAL
  RETRYING
  BLOCKED
  COMPLETE
  PARTIAL
  FAILED
  CANCELLED
}

enum AutonomousStepStatus {
  PENDING
  READY
  RUNNING
  AWAITING_INPUT
  AWAITING_APPROVAL
  RETRYING
  COMPLETE
  SKIPPED
  BLOCKED
  FAILED
  CANCELLED
}

enum AutonomousInvocationStatus {
  REQUESTED
  RUNNING
  SUCCEEDED
  RETRYABLE_FAILURE
  FATAL_FAILURE
  CANCELLED
}

enum AutonomousApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

model AutonomousGoal {
  id              String               @id @default(cuid())
  tenantId        String?
  projectId       String?
  intakeId        String?
  parentGoalId    String?
  objective       String               @db.Text
  successCriteria Json
  constraints     Json?
  priority        Int                  @default(50)
  status          AutonomousGoalStatus @default(DRAFT)
  requestedBy     String?
  dueAt           DateTime?
  tokenBudget     Int?
  costBudgetCents Int?
  timeBudgetMs    Int?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  completedAt     DateTime?

  parent   AutonomousGoal?  @relation("AutonomousGoalTree", fields: [parentGoalId], references: [id], onDelete: SetNull)
  children AutonomousGoal[] @relation("AutonomousGoalTree")
  runs     AutonomousRun[]

  @@index([tenantId, status, priority])
  @@index([projectId, status])
  @@index([intakeId, status])
  @@index([parentGoalId])
  @@map("autonomous_goals")
}

model AutonomousAgentDefinition {
  id              String   @id @default(cuid())
  slug            String
  version         Int      @default(1)
  displayName     String
  runtimeKind     String
  description     String?  @db.Text
  systemPrompt    String?  @db.Text
  capabilities    String[]
  allowedTools    String[]
  modelPolicy     Json?
  authorityPolicy Json?
  budgetPolicy    Json?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  steps AutonomousStep[]

  @@unique([slug, version])
  @@index([active, slug])
  @@map("autonomous_agent_definitions")
}

model AutonomousRun {
  id                   String              @id @default(cuid())
  goalId               String
  idempotencyKey       String              @unique
  runtimeKind          String              @default("supervisor")
  status               AutonomousRunStatus @default(QUEUED)
  plan                 Json?
  context              Json?
  result               Json?
  errorCode            String?
  errorMessage         String?             @db.Text
  currentStepKey       String?
  attempt              Int                 @default(0)
  maxAttempts          Int                 @default(3)
  tokensUsed           Int                 @default(0)
  costCents            Int                 @default(0)
  elapsedMs            Int                 @default(0)
  leaseOwner           String?
  leaseExpiresAt       DateTime?
  heartbeatAt          DateTime?
  externalWorkflowId   String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  startedAt            DateTime?
  completedAt          DateTime?

  goal      AutonomousGoal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  steps     AutonomousStep[]
  approvals AutonomousApproval[]
  events    AutonomousEvent[]
  evidence  AutonomousEvidence[]

  @@index([goalId, status])
  @@index([status, leaseExpiresAt])
  @@index([externalWorkflowId])
  @@map("autonomous_runs")
}

model AutonomousStep {
  id                String               @id @default(cuid())
  runId             String
  stepKey           String
  sequence          Int
  agentDefinitionId String?
  capability        String
  title             String
  status            AutonomousStepStatus @default(PENDING)
  dependsOn         String[]
  input              Json?
  output             Json?
  completionCriteria Json?
  retryPolicy        Json?
  approvalPolicy     Json?
  attempt            Int                  @default(0)
  maxAttempts        Int                  @default(3)
  tokensUsed         Int                  @default(0)
  costCents          Int                  @default(0)
  errorCode          String?
  errorMessage       String?              @db.Text
  availableAt        DateTime             @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  run         AutonomousRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  agent       AutonomousAgentDefinition?  @relation(fields: [agentDefinitionId], references: [id], onDelete: SetNull)
  invocations AutonomousToolInvocation[]
  approvals   AutonomousApproval[]
  evidence    AutonomousEvidence[]

  @@unique([runId, stepKey])
  @@unique([runId, sequence])
  @@index([runId, status, availableAt])
  @@index([agentDefinitionId])
  @@index([capability, status])
  @@map("autonomous_steps")
}

model AutonomousToolInvocation {
  id             String                     @id @default(cuid())
  stepId         String
  idempotencyKey String                     @unique
  toolName       String
  status         AutonomousInvocationStatus @default(REQUESTED)
  input          Json?
  output         Json?
  errorCode      String?
  errorMessage   String?                    @db.Text
  attempt        Int                        @default(0)
  durationMs     Int?
  tokensUsed     Int                        @default(0)
  costCents      Int                        @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  step AutonomousStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId, status])
  @@index([toolName, status])
  @@map("autonomous_tool_invocations")
}

model AutonomousApproval {
  id              String                   @id @default(cuid())
  runId           String
  stepId          String?
  approvalType    String
  status          AutonomousApprovalStatus @default(PENDING)
  requestedRole   String?
  requestedUserId String?
  tokenHash       String                   @unique
  request         Json?
  response        Json?
  expiresAt       DateTime?
  decidedBy       String?
  decidedAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  run  AutonomousRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  step AutonomousStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@index([stepId, status])
  @@index([requestedUserId, status])
  @@map("autonomous_approvals")
}

model AutonomousMemory {
  id         String   @id @default(cuid())
  tenantId   String?
  projectId  String?
  intakeId   String?
  agentSlug  String?
  scope      String
  memoryKey  String
  content    Json
  importance Float    @default(0.5)
  sourceRunId String?
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([scope, memoryKey, projectId, intakeId, agentSlug])
  @@index([tenantId, scope])
  @@index([projectId, scope])
  @@index([intakeId, scope])
  @@index([agentSlug, scope])
  @@index([expiresAt])
  @@map("autonomous_memories")
}

model AutonomousEvidence {
  id          String   @id @default(cuid())
  runId       String
  stepId      String?
  evidenceType String
  sourceUri   String?
  sourceTitle String?
  contentHash String?
  excerpt     String?  @db.Text
  payload     Json?
  confidence  Float?
  verifiedAt DateTime?
  validUntil  DateTime?
  createdAt   DateTime @default(now())

  run  AutonomousRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  step AutonomousStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([runId, evidenceType])
  @@index([stepId])
  @@index([contentHash])
  @@index([validUntil])
  @@map("autonomous_evidence")
}

model AutonomousEvent {
  id        String   @id @default(cuid())
  runId     String
  sequence  Int
  eventType String
  actorType String
  actorId   String?
  payload   Json
  createdAt DateTime @default(now())

  run AutonomousRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, createdAt])
  @@index([eventType, createdAt])
  @@map("autonomous_events")
}
