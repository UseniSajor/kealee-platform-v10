  WEB_CHAT
  PORTAL_CHAT
}

enum AiCommunicationSessionStatus {
  PENDING
  ACTIVE
  TRANSFERRING
  COMPLETED
  FAILED
  REDACTED
}

enum SupportCaseStatus {
  OPEN
  AUTHENTICATING
  INVESTIGATING
  WAITING_CUSTOMER
  WAITING_STAFF
  ESCALATED
  RESOLVED
  CLOSED
}

model AiCommunicationSession {
  id                String                       @id @default(uuid())
  organizationId    String?
  contactId         String?
  leadId            String?
  projectId         String?
  provider          String
  providerSessionId String?                      @unique
  channel           AiCommunicationChannel
  direction         String
  status            AiCommunicationSessionStatus @default(PENDING)
  locale            String                       @default("en-US")
  consentId         String?
  disclosureVersion String?
  recordingEnabled  Boolean                      @default(false)
  retentionUntil    DateTime?
  startedAt         DateTime?
  endedAt           DateTime?
  metadata          Json?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@index([organizationId, createdAt])
  @@index([contactId, createdAt])
  @@index([projectId, createdAt])
  @@index([status, createdAt])
  @@map("ai_communication_sessions")
}

model AiConversationArtifact {
  id              String   @id @default(uuid())
  sessionId       String
  artifactType    String
  encryptedBody   String?  @db.Text
  redactedBody    String?  @db.Text
  storageUrl      String?
  encryptionKeyId String?
  contentHash     String
  model           String?
  confidence      Decimal? @db.Decimal(5, 4)
  metadata        Json?
  createdAt       DateTime @default(now())

  @@unique([sessionId, artifactType, contentHash])
  @@index([sessionId, createdAt])
  @@map("ai_conversation_artifacts")
}

model AiSalesWorkflow {
  id             String   @id @default(uuid())
  organizationId String
  contactId      String?
  leadId         String?
  projectId      String?
  state           String   @default("NEW")
  completedSteps  String[] @default([])
  appliedEventIds String[] @default([])
  version         Int      @default(0)
  humanOwnerId    String?
  stoppedAt       DateTime?
  stopReason      String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId, state, updatedAt])
  @@index([leadId])
  @@index([projectId])
  @@map("ai_sales_workflows")
}

model CustomerSupportCase {
  id                 String            @id @default(uuid())
  organizationId     String
  contactId          String?
  projectId          String?
  sessionId          String?
  status             SupportCaseStatus @default(OPEN)
  topic              String
  urgency            String
  sentiment          String?
  confidence         Decimal?          @db.Decimal(5, 4)
  assignedToUserId   String?
  slaDueAt           DateTime?
  resolutionCriteria String?           @db.Text
  resolvedAt         DateTime?
  closedAt           DateTime?
  metadata           Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([organizationId, status, slaDueAt])
  @@index([projectId, createdAt])
  @@index([assignedToUserId, status])
  @@map("customer_support_cases")
}

enum AutonomousGoalStatus {
  DRAFT
  READY
  ACTIVE
  PAUSED
  BLOCKED
  COMPLETE
  CANCELLED
  FAILED
}

enum AutonomousRunStatus {
  QUEUED
  PLANNING
  RUNNING
  AWAITING_INPUT
  AWAITING_APPROVAL
  RETRYING
  BLOCKED
  COMPLETE
  PARTIAL
  FAILED
  CANCELLED
}

enum AutonomousStepStatus {
  PENDING
  READY
  RUNNING
  AWAITING_INPUT
  AWAITING_APPROVAL
  RETRYING
  COMPLETE
  SKIPPED
  BLOCKED
  FAILED
  CANCELLED
}

enum AutonomousInvocationStatus {
  REQUESTED
  RUNNING
  SUCCEEDED
  RETRYABLE_FAILURE
  FATAL_FAILURE
  CANCELLED
}

enum AutonomousApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

model AutonomousGoal {
  id              String               @id @default(cuid())
  tenantId        String?
  projectId       String?
  intakeId        String?
  parentGoalId    String?
  objective       String               @db.Text
  successCriteria Json
  constraints     Json?
  priority        Int                  @default(50)
  status          AutonomousGoalStatus @default(DRAFT)
  requestedBy     String?
  dueAt           DateTime?
  tokenBudget     Int?
  costBudgetCents Int?
  timeBudgetMs    Int?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  completedAt     DateTime?

  parent   AutonomousGoal?  @relation("AutonomousGoalTree", fields: [parentGoalId], references: [id], onDelete: SetNull)
  children AutonomousGoal[] @relation("AutonomousGoalTree")
  runs     AutonomousRun[]

  @@index([tenantId, status, priority])
  @@index([projectId, status])
  @@index([intakeId, status])
  @@index([parentGoalId])
  @@map("autonomous_goals")
}

model AutonomousAgentDefinition {
  id              String   @id @default(cuid())
  slug            String
  version         Int      @default(1)
  displayName     String
  runtimeKind     String
  description     String?  @db.Text
  systemPrompt    String?  @db.Text
  capabilities    String[]
  allowedTools    String[]
  modelPolicy     Json?
  authorityPolicy Json?
  budgetPolicy    Json?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  steps AutonomousStep[]

  @@unique([slug, version])
  @@index([active, slug])
  @@map("autonomous_agent_definitions")
}

model AutonomousRun {
  id                   String              @id @default(cuid())
  goalId               String
  idempotencyKey       String              @unique
  runtimeKind          String              @default("supervisor")
  status               AutonomousRunStatus @default(QUEUED)
  plan                 Json?
  context              Json?
  result               Json?
  errorCode            String?
  errorMessage         String?             @db.Text
  currentStepKey       String?
  attempt              Int                 @default(0)
  maxAttempts          Int                 @default(3)
  tokensUsed           Int                 @default(0)
  costCents            Int                 @default(0)
  elapsedMs            Int                 @default(0)
  leaseOwner           String?
  leaseExpiresAt       DateTime?
  heartbeatAt          DateTime?
  externalWorkflowId   String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  startedAt            DateTime?
  completedAt          DateTime?

  goal      AutonomousGoal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  steps     AutonomousStep[]
  approvals AutonomousApproval[]
  events    AutonomousEvent[]
  evidence  AutonomousEvidence[]

  @@index([goalId, status])
  @@index([status, leaseExpiresAt])
  @@index([externalWorkflowId])
  @@map("autonomous_runs")
}

model AutonomousStep {
  id                String               @id @default(cuid())
  runId             String
  stepKey           String
  sequence          Int
  agentDefinitionId String?
  capability        String
  title             String
  status            AutonomousStepStatus @default(PENDING)
  dependsOn         String[]
  input              Json?
  output             Json?
  completionCriteria Json?
  retryPolicy        Json?
  approvalPolicy     Json?
  attempt            Int                  @default(0)
  maxAttempts        Int                  @default(3)
  tokensUsed         Int                  @default(0)
  costCents          Int                  @default(0)
  errorCode          String?
  errorMessage       String?              @db.Text
  availableAt        DateTime             @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  run         AutonomousRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  agent       AutonomousAgentDefinition?  @relation(fields: [agentDefinitionId], references: [id], onDelete: SetNull)
  invocations AutonomousToolInvocation[]
  approvals   AutonomousApproval[]
  evidence    AutonomousEvidence[]

  @@unique([runId, stepKey])
  @@unique([runId, sequence])
  @@index([runId, status, availableAt])
  @@index([agentDefinitionId])
  @@index([capability, status])
  @@map("autonomous_steps")
}

model AutonomousToolInvocation {
  id             String                     @id @default(cuid())
  stepId         String
  idempotencyKey String                     @unique
  toolName       String
  status         AutonomousInvocationStatus @default(REQUESTED)
  input          Json?
  output         Json?
  errorCode      String?
  errorMessage   String?                    @db.Text
  attempt        Int                        @default(0)
  durationMs     Int?
  tokensUsed     Int                        @default(0)
  costCents      Int                        @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  step AutonomousStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId, status])
  @@index([toolName, status])
  @@map("autonomous_tool_invocations")
}

model AutonomousApproval {
  id              String                   @id @default(cuid())
  runId           String
  stepId          String?
  approvalType    String
  status          AutonomousApprovalStatus @default(PENDING)
  requestedRole   String?
  requestedUserId String?
  tokenHash       String                   @unique
  request         Json?
  response        Json?
  expiresAt       DateTime?
  decidedBy       String?
  decidedAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  run  AutonomousRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
