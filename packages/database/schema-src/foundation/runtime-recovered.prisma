model SitePlanWorkflow {
  id                         String            @id @default(uuid())
  organizationId             String
  projectId                  String
  propertyId                 String?
  parcelId                   String?
  productId                  String?
  /// Workflow definition version this instance was started under. A worker
  /// refuses to run a stage under a different version rather than mixing
  /// definitions mid-flight.
  definitionVersion         Int               @default(1)
  /// The order that activated this workflow.
  orderId                   String?
  /// Stable key from order + definition version, so duplicate webhook
  /// delivery resolves to the same workflow instead of creating a second.
  idempotencyKey            String?           @unique
  currentStage               SitePlanStageCode @default(PARCEL_RESOLUTION)
  status                     String            @default("ACTIVE")
  version                    Int               @default(0)
  professionalReviewRequired Boolean           @default(true)
  releasedAt                 DateTime?
  metadata                   Json?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  @@unique([organizationId, projectId])
  @@index([organizationId, status, updatedAt])
  @@map("site_plan_workflows")
}

model SitePlanStageExecution {
  id              String              @id @default(uuid())
  workflowId      String
  /// Detailed registered job name, e.g. siteplan.render_exports. `stage`
  /// carries the coarse SitePlanStageCode the schema already had; the
  /// state machine sequences on THIS, so resume needs it persisted.
  job                String?
  /// JobQueue row that executed this stage, for trace correlation.
  jobQueueId         String?
  stage           SitePlanStageCode
  status          SitePlanStageStatus @default(NOT_STARTED)
  attempt         Int                 @default(1)
  prerequisites   Json
  inputs          Json?
  outputs         Json?
  blockers        Json?
  assignedPartyId String?
  startedAt       DateTime?
  completedAt     DateTime?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([workflowId, stage, attempt])
  @@index([workflowId, stage, status])
  @@index([status, updatedAt])
  @@map("site_plan_stage_executions")
}

