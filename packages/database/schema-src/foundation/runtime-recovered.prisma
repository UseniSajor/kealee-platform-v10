// Runtime models recovered from the former monolithic schema.
// This file is now part of the modular schema source of truth.

enum SiteAccuracyClass {
  SURVEY_GRADE
  MAPPING_GRADE
  APPROXIMATE
  SCHEMATIC
  UNKNOWN
}

enum SiteSourceDatasetType {
  SURVEY
  PARCEL
  ZONING
  EASEMENT
  FLOOD
  WETLAND
  UTILITY
  TOPO
  LIDAR
  SOILS
  AERIAL
  USER_UPLOAD
}

enum SiteConstraintType {
  PROPERTY_LINE
  SETBACK
  EASEMENT
  FLOODPLAIN
  WETLAND
  BUFFER
  UTILITY
  RIGHT_OF_WAY
  CRITICAL_AREA
  SLOPE_LIMIT
  EXCLUSION_ZONE
}

enum SiteConstraintSeverity {
  INFORMATIONAL
  WARNING
  BLOCKING
}

model SiteSourceDataset {
  id               String                @id @default(uuid())
  organizationId   String
  projectId        String
  parcelId         String?
  type             SiteSourceDatasetType
  provider         String
  sourceUrl        String?
  license          String?
  retrievedAt      DateTime
  effectiveDate    DateTime?
  crs              String
  linearUnit       String
  // Provenance required on every site object: a GIS layer is not a field survey,
  // and most parcel/zoning layers carry no elevation at all — verticalDatum null
  // is a meaningful answer, distinct from UNKNOWN.
  horizontalDatum  String?
  verticalDatum    String?
  accuracyClass    SiteAccuracyClass     @default(UNKNOWN)
  reliabilityLevel Int                   @default(1)
  responsibleProfessionalId String?
  checksum         String
  confidence       Decimal               @db.Decimal(5, 4)
  rawArtifactId    String?
  metadata         Json?
  version          Int                   @default(1)
  supersedesId     String?
  createdBy        String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  parcel      Parcel?            @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  constraints SiteConstraint[]
  terrainModels SiteTerrainModel[]

  @@unique([organizationId, projectId, type, checksum])
  @@index([organizationId, projectId, type])
  @@index([parcelId, effectiveDate])
  @@map("site_source_datasets")
}

model SiteConstraint {
  id               String                 @id @default(uuid())
  organizationId   String
  projectId        String
  parcelId         String?
  sourceDatasetId  String?
  type             SiteConstraintType
  geometryGeoJson  Json
  crs              String
  linearUnit       String
  ruleReference    String?
  severity         SiteConstraintSeverity @default(WARNING)
  confidence       Decimal                @db.Decimal(5, 4)
  effectiveDate    DateTime?
  metadata         Json?
  version          Int                    @default(1)
  supersedesId     String?
  createdAt        DateTime               @default(now())

  parcel        Parcel?            @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  sourceDataset SiteSourceDataset? @relation(fields: [sourceDatasetId], references: [id], onDelete: SetNull)

  @@index([organizationId, projectId, type])
  @@index([parcelId, severity])
  @@index([sourceDatasetId])
  @@map("site_constraints")
}

model SiteTerrainModel {
  id                    String   @id @default(uuid())
  organizationId        String
  projectId             String
  parcelId              String?
  sourceDatasetId       String
  crs                   String
  linearUnit            String
  demArtifactId         String?
  pointCloudArtifactId  String?
  slopeRasterArtifactId String?
  contourArtifactId     String?
  contourInterval       Decimal? @db.Decimal(10, 3)
  surfaceStatistics     Json
  processingVersion     String
  confidence            Decimal  @db.Decimal(5, 4)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  parcel        Parcel?           @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  sourceDataset SiteSourceDataset @relation(fields: [sourceDatasetId], references: [id], onDelete: Restrict)

  @@index([organizationId, projectId])
  @@index([parcelId])
  @@index([sourceDatasetId])
  @@map("site_terrain_models")
}

enum FeasibilityScenarioStatus {
  DRAFT
  SOLVING
  SOLVED
  NEEDS_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
}

enum FeasibilityTypology {
  SINGLE_FAMILY
  TOWNHOME
  GARDEN_MULTIFAMILY
  WRAP_PODIUM_MULTIFAMILY
  SURFACE_PARKING
  SMALL_MIXED_USE
  ADU
  ADDITION
  POOL
  NEW_HOME
}

enum FeasibilityReviewStatus {
  NOT_REQUESTED
  PENDING
  CHANGES_REQUESTED
  REVIEWED
}

model FeasibilityScenarioOption {
  id                 String   @id @default(uuid())
  scenarioId         String
  ordinal            Int
  name               String
  geometryGeoJson    Json
  buildingModel      Json
  siteCoverage       Float
  far                Float
  grossFloorArea     Decimal  @db.Decimal(14, 2)
  netRentableArea    Decimal? @db.Decimal(14, 2)
  unitCount          Int
  unitMix            Json
  parkingSpaces      Int
  circulationArea    Decimal? @db.Decimal(14, 2)
  landscapeArea      Decimal? @db.Decimal(14, 2)
  imperviousArea     Decimal? @db.Decimal(14, 2)
  preliminaryCutFill Json?
  earthworkConfidence Decimal? @db.Decimal(5, 4)
  estimateId         String?
  proFormaReference  String?
  score              Float
  validationReport   Json
  geoJsonArtifactId  String?
  dxfArtifactId      String?
  ifcArtifactId      String?
  pdfArtifactId      String?
  solverVersion      String
  inputHash          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  scenario FeasibilityScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  validationRuns GeometryValidationRun[]

  @@unique([scenarioId, ordinal])
  @@index([scenarioId, score])
  @@map("feasibility_scenario_options")
}

model GeometryValidationRun {
  id              String   @id @default(uuid())
  scenarioOptionId String
  ruleSetVersion  String
  solverVersion   String
  inputHash       String
  inputs          Json
  results         Json
  errors          Json
  warnings        Json
  valid           Boolean
  createdAt       DateTime @default(now())

  scenarioOption FeasibilityScenarioOption @relation(fields: [scenarioOptionId], references: [id], onDelete: Cascade)

  @@unique([scenarioOptionId, inputHash])
  @@index([scenarioOptionId, createdAt])
  @@index([valid, createdAt])
  @@map("geometry_validation_runs")
}

model CtcCostDatabase {
  id                    String   @id
  name                  String
  source                String
  region                String?
  baseYear              Int      @default(2023) @map("base_year")
  escalationYear        Int?     @map("escalation_year")
  escalationFactor      Decimal  @default(1.0) @db.Decimal(8, 4) @map("escalation_factor")
  publisher             String?
  copyrightHolder       String?  @map("copyright_holder")
  licensee              String?
  rightsBasis           String?  @map("rights_basis")
  platformCustodian     String   @default("Kealee Services LLC") @map("platform_custodian")
  redistributionAllowed Boolean  @default(false) @map("redistribution_allowed")
  isMaster              Boolean  @default(true) @map("is_master")
  costPdf               String?  @map("cost_pdf")
  technicalPdf          String?  @map("technical_pdf")
  taskCount             Int      @default(0) @map("task_count")
  specCount             Int      @default(0) @map("spec_count")
  importedAt            DateTime @default(now()) @map("imported_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tasks CtcCostTask[]
  specs CtcTechnicalSpec[]

  @@index([isMaster])
  @@index([source])
  @@map("ctc_cost_database")
}

model CtcCostTask {
  id                     BigInt   @id @default(autoincrement())
  databaseId             String   @map("database_id")
  taskNumber             String   @map("task_number")
  csiCode                String?  @map("csi_code")
  csiDivision            String?  @map("csi_division")
  description            String
  uom                    String?
  unitPrice2023          Decimal? @db.Decimal(14, 4) @map("unit_price_2023")
  laborCost2023          Decimal? @db.Decimal(14, 4) @map("labor_cost_2023")
  materialCost2023       Decimal? @db.Decimal(14, 4) @map("material_cost_2023")
  equipmentCost2023      Decimal? @db.Decimal(14, 4) @map("equipment_cost_2023")
  laborHours             Decimal? @db.Decimal(12, 4) @map("labor_hours")
  laborRate2023          Decimal? @db.Decimal(10, 2) @map("labor_rate_2023")
  laborHoursMethod       String?  @map("labor_hours_method")
  laborRateSourceTask    String?  @map("labor_rate_source_task")
  laborRateTrade         String?  @map("labor_rate_trade")
  laborRateEffectiveDate DateTime? @db.Date @map("labor_rate_effective_date")
  escalationFactor       Decimal  @default(1.0) @db.Decimal(8, 4) @map("escalation_factor")
  unitPriceCurrent       Decimal? @db.Decimal(14, 4) @map("unit_price_current")
  isModifier             Boolean  @default(false) @map("is_modifier")
  modifierOf             String?  @map("modifier_of")
  modifierType           String?  @map("modifier_type")
  modifierValue          Decimal? @db.Decimal(14, 4) @map("modifier_value")
  page                   Int?
  source                 String   @default("CTC-2023")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  database CtcCostDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@unique([databaseId, taskNumber])
  @@index([csiDivision])
  @@index([csiCode])
  @@index([taskNumber])
  @@map("ctc_cost_tasks")
}

model CtcTechnicalSpec {
  id          BigInt   @id @default(autoincrement())
  databaseId  String   @map("database_id")
  specNumber  String?  @map("spec_number")
  csiCode     String?  @map("csi_code")
  csiDivision String?  @map("csi_division")
  title       String?
  body        String?  @db.Text
  page        Int?
  source      String   @default("CTC-2023")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  database CtcCostDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@unique([databaseId, specNumber])
  @@index([csiCode])
  @@index([csiDivision])
  @@map("ctc_technical_specs")
}

model MeasurementSession {
  id           String   @id @default(cuid())
  userId       String?
  projectId    String?
  intakeId     String?
  deviceModel  String
  capabilities Json
  startedAt    DateTime @default(now())
  endedAt      DateTime?

  measurements      Measurement[]
  calibrationObjects CalibrationObject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([intakeId])
}

model Measurement {
  id         String             @id @default(cuid())
  sessionId  String
  session    MeasurementSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  distance   Float
  unit       String
  method     String
  accuracy   String
  confidence Int
  projectId  String?
  intakeId   String?
  userId     String?
  metadata   Json?
  recordedAt DateTime           @default(now())
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([sessionId])
  @@index([projectId])
  @@index([intakeId])
  @@index([userId])
  @@index([method])
  @@index([confidence])
}

model CalibrationObject {
  id               String             @id @default(cuid())
  sessionId        String
  session          MeasurementSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  objectType       String
  knownDimension   Float
  pixelSize        Float
  calibrationScore Float
  createdAt        DateTime           @default(now())

  @@index([sessionId])
}

model ProjectOutput {
  id        String   @id @default(uuid())
  projectId String?
  intakeId  String?
  orderId   String?
  type      String
  status    String   @default("pending")
  resultJson Json?
  pdfUrl    String?
  downloadUrl String?
  generatedAt DateTime @default(now())
  completedAt DateTime?
  metadata  Json?

  serviceType             String?  @default("concept")
  conceptServiceLeadId    String?
  estimationServiceLeadId String?
  permitServiceLeadId     String?
  deliveryStatus          String?  @default("pending")
  fileMetadata            Json?    @default("{}")
  conceptImageUrls        String[] @default([])
  estimationPdfUrl        String?
  permitFileUrls          String[] @default([])

  @@index([status])
  @@index([type])
  @@index([intakeId])
  @@index([orderId])
  @@index([generatedAt])
  @@index([serviceType])
  @@index([deliveryStatus])
  @@index([conceptServiceLeadId])
  @@index([estimationServiceLeadId])
  @@index([permitServiceLeadId])
  @@map("project_outputs")
}

enum RevenueCreditSourceType {
  CAMPAIGN_BONUS
  QUALITY_CREDIT
}

enum DeliverableCorrectionStatus {
  REQUESTED
  IN_PROGRESS
  DELIVERED
  ESCALATED_TO_CREDIT
}

model RevenueProduct {
  id                  String   @id @default(uuid())
  productKey          String   @unique
  name                String
  customerType        String   // homeowner | contractor | developer
  priceCents          Int
  active              Boolean  @default(true)
  intakeSchemaId      String
  workflowTemplateId  String
  responsibleAgent    String
  propertyIntelDepth  String   // basic | project | contractor | development
  requiredApprovals   Json
  notificationRuleSetId String
  fulfillmentSlaHours Int
  slaAnchor           String   @default("payment") // payment | intake_complete
  revisionLimit       Int
  exclusions          Json
  upsellProductIds    String[]
  dailyCapacity       Int?
  aiCostLimitCents    Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  creditLedgerEntries ProductCreditLedger[]
  corrections         DeliverableCorrection[]
}

model ProductCreditLedger {
  id                 String   @id @default(uuid())
  intakeId           String
  productId          String?
  sourceType         RevenueCreditSourceType
  amountCents        Int
  reason             String?
  approvedByUserId   String?
  earnedAt           DateTime @default(now())
  expiresAt          DateTime
  redeemedAt         DateTime?
  redeemedOnIntakeId String?

  product RevenueProduct? @relation(fields: [productId], references: [id])

  @@index([intakeId])
}

model DeliverableCorrection {
  id              String   @id @default(uuid())
  intakeId        String
  productId       String?
  requestedBy     String   // customer | staff
  reason          String
  affectedSection String
  status          DeliverableCorrectionStatus @default(REQUESTED)
  assignedAgent   String?
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?

  product RevenueProduct? @relation(fields: [productId], references: [id])

  @@index([intakeId])
}

model RevenueTransaction {
  id                    String   @id @default(uuid())
  intakeId              String
  productId             String?
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId String?
  grossCents            Int
  commissionCents       Int      @default(0)
  fulfillmentCostCents   Int      @default(0)
  netCents              Int
  status                String   // pending | cleared | disputed | disputed_lost
  disputedAt            DateTime?
  recognizedAt          DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([intakeId])
  @@index([status])
}

