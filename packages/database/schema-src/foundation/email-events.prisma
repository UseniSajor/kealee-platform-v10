// FOUNDATION — Email Events
// Added for security and observability of outgoing emails

enum EmailEventStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
}

model EmailEvent {
  id                  String           @id @default(uuid())
  provider            String           @default("resend")
  providerEmailId     String?
  route               String?          // e.g. "/api/contact"
  template            String?          // Name or ID of template used
  fromEmail           String
  toEmail             String
  subject             String
  triggeredByUserId   String?
  projectId           String?
  ipAddress           String?
  userAgent           String?          @db.Text
  status              EmailEventStatus @default(QUEUED)
  errorMessage        String?          @db.Text
  metadata            Json?

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([toEmail])
  @@index([status])
  @@index([createdAt])
  @@index([triggeredByUserId])
  @@index([projectId])
  @@map("email_events")
}
