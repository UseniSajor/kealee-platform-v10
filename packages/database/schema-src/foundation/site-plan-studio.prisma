// Kealee Site Plan Studio — the professional production workspace.
// Merged into prisma/schema.prisma by scripts/merge-schema.ts.
// Migration: prisma/migrations/20260926120000_site_plan_studio
//
// Every table carries organizationId (an Org IS the tenant) and, where it has
// one, workspaceId and projectId, so row-level security can filter without a
// join once `withTenant()` is in place (KEALEE.md: RLS is NOT enabled yet).
// The engine logic these rows persist lives in packages/spatial-engine/src/studio.
// No existing model is altered.

/// A team workspace inside an organisation (a firm's production group).
model StudioWorkspace {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@map("studio_workspaces")
}

/// A person's role in an organisation's Studio. Activated only after the
/// invitation, the professional terms and (for PE / surveyor) a verified licence.
model StudioMembership {
  id               String    @id @default(uuid())
  organizationId   String
  workspaceId      String?
  userId           String
  /// SITE_PLAN_DRAFTER | ENGINEERING_TECH | ENGINEER_IN_TRAINING | PROFESSIONAL_ENGINEER | SURVEYOR | REVIEWER | PROJECT_MANAGER | ADMIN
  role             String
  /// PENDING_TERMS | PENDING_PROFILE | PENDING_VERIFICATION | ACTIVE | SUSPENDED
  status           String    @default("PENDING_TERMS")
  /// Empty = every project in the workspace.
  projectIds       String[]  @default([])
  jurisdictions    String[]  @default([])
  invitationId     String?
  termsVersion     String?
  termsAcceptedAt  DateTime?
  onboarding       Json      @default("{}")
  activatedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
  @@map("studio_memberships")
}

/// One professional licence. A professional holds as many as they have
/// states; none authorises work in another state.
model ProfessionalLicense {
  id             String    @id @default(uuid())
  userId         String
  /// PE | PLS | RA | RLA
  kind           String
  /// Issuing jurisdiction, e.g. MD, VA, DC.
  state          String
  number         String
  discipline     String?
  expiresAt      DateTime?
  /// UNVERIFIED | PENDING | VERIFIED | REJECTED | EXPIRED | REVOKED
  verification   String    @default("PENDING")
  verifiedById   String?
  verifiedAt     DateTime?
  verificationNote String? @db.Text
  evidenceUrl    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, kind, state])
  @@index([verification])
  @@map("professional_licenses")
}

/// Professional details the review profile does not hold. Keyed by user.
model ProfessionalDetail {
  userId              String    @id
  title               String?
  phone               String?
  firmName            String?
  disciplines         String[]  @default([])
  insuranceCarrier    String?
  insurancePolicy     String?
  insuranceExpiresAt  DateTime?
  /// Set by an administrator after verification, never by the professional.
  signatureAuthority  Boolean   @default(false)
  sealAuthority       Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("professional_details")
}

/// A professional invitation. Only the SHA-256 of the token is stored.
model StudioInvitation {
  id             String    @id @default(uuid())
  organizationId String
  workspaceId    String?
  projectIds     String[]  @default([])
  invitedRole    String
  invitedById    String
  email          String?
  tokenHash      String    @unique
  expiresAt      DateTime
  maxUses        Int       @default(1)
  uses           Int       @default(0)
  /// PENDING | ACCEPTED | EXPIRED | REVOKED
  status         String    @default("PENDING")
  jurisdictions  String[]  @default([])
  acceptedById   String?
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId, status])
  @@map("studio_invitations")
}

/// A Studio project: the canonical model's header and professional state.
model StudioProject {
  id                       String   @id @default(uuid())
  organizationId           String
  workspaceId              String
  /// Link to the platform Project, when the plan belongs to one.
  linkedProjectId          String?
  /// The site-plan workflow a generated plan came from.
  workflowId               String?
  name                     String
  address                  String?
  jurisdictionCode         String?
  /// The state whose licences govern professional acts on this project.
  licenceState             String?
  /// INTAKE … APPROVED (spatial-engine/src/studio/access.ts PROJECT_STATES)
  state                    String   @default("DRAFTING")
  currentRevision          Int      @default(1)
  currentRevisionId        String
  crs                      String   @default("EPSG:2248")
  verticalDatum            String?
  zoning                   Json?
  design                   Json?
  facts                    Json     @default("{}")
  sheets                   Json?
  aiGenerated              Boolean  @default(false)
  previouslySubmitted      Boolean  @default(false)
  traditionalEstimateHours Float?
  isDemo                   Boolean  @default(false)
  createdById              String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([organizationId, workspaceId, updatedAt])
  @@index([workflowId])
  @@map("studio_projects")
}

/// Current state of every canonical object. History is in studio_revisions.
model StudioObject {
  id              String   @id
  organizationId  String
  workspaceId     String
  projectId       String
  type            String
  geometry        Json
  attributes      Json     @default("{}")
  layer           String
  discipline      String
  source          String
  sourceDate      String?
  sourceAccuracy  String
  sourceAuthority String?
  confidence      Float
  createdBy       String
  createdAt       DateTime
  modifiedBy      String
  modifiedAt      DateTime
  revisionId      String
  status          String

  @@index([projectId, type])
  @@index([organizationId])
  @@map("studio_objects")
}

/// Append-only. Every accepted change and every import, with the before/after
/// of each object it touched — enough to reverse it or to audit it.
model StudioRevision {
  id             String   @id @default(uuid())
  organizationId String
  workspaceId    String
  projectId      String
  revision       Int
  revisionId     String   @unique
  parentRevision Int
  proposalId     String?
  commands       Json
  changes        Json
  summary        String   @db.Text
  createdBy      String
  createdAt      DateTime
  engineVersion  String

  @@unique([projectId, revision])
  @@index([organizationId])
  @@map("studio_revisions")
}

model StudioProposal {
  id                String    @id
  organizationId    String
  workspaceId       String
  projectId         String
  baseRevision      Int
  /// PROPOSED | INVALID | ACCEPTED | REJECTED | SUPERSEDED | STALE
  status            String
  commands          Json
  errors            Json      @default("[]")
  preview           Json?
  material          Boolean   @default(true)
  stopConditions    Json      @default("[]")
  mode              String?
  prompt            String?   @db.Text
  requestedBy       String
  engineVersion     String
  createdAt         DateTime
  decision          String?
  decidedBy         String?
  decidedAt         DateTime?
  resultingRevision Int?

  @@index([projectId, status])
  @@index([organizationId])
  @@map("studio_proposals")
}

model StudioCalculation {
  id             String   @id @default(uuid())
  organizationId String
  workspaceId    String
  projectId      String
  revision       Int
  calcId         String
  status         String
  record         Json
  createdAt      DateTime @default(now())

  @@index([projectId, calcId])
  @@map("studio_calculations")
}

model StudioRuleOverride {
  id             String   @id @default(uuid())
  organizationId String
  workspaceId    String
  projectId      String
  ruleKey        String
  overriddenBy   String
  reason         String   @db.Text
  overriddenAt   DateTime

  @@unique([projectId, ruleKey])
  @@map("studio_rule_overrides")
}

/// Immutable, hash-chained engineering event log. UPDATE and DELETE are
/// refused by trigger (see the migration). trainingConsent is always false.
model StudioEngineeringEvent {
  id                 String   @id
  organizationId     String
  workspaceId        String?
  projectId          String?
  sequence           Int
  occurredAt         DateTime
  eventType          String
  userId             String?
  role               String?
  actorType          String
  mode               String?
  origin             String?
  prompt             String?  @db.Text
  selectedObjectIds  Json     @default("[]")
  aiInterpretation   Json?
  proposedCommands   Json?
  validationResults  Json?
  decision           String?
  manualEdits        Json?
  resultingRevision  Int?
  proposalId         String?
  engineVersion      String
  rulesVersion       String?
  durationMs         Int?
  detail             Json?
  trainingConsent    Boolean  @default(false)
  prevHash           String?
  hash               String

  @@unique([organizationId, sequence])
  @@index([projectId, sequence])
  @@index([eventType, occurredAt])
  @@map("studio_engineering_events")
}

model StudioIssuance {
  id                    String    @id
  organizationId        String
  projectId             String
  revision              Int
  revisionId            String
  /// PREPARED | APPROVED | EXECUTED | INVALIDATED
  state                 String
  documentHash          String
  documentRef           String?
  preparedBy            String
  preparedAt            DateTime
  approval              Json?
  execution             Json?
  invalidatedAt         DateTime?
  invalidatedByRevision Int?
  invalidationReason    String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([projectId, revision])
  @@map("studio_issuances")
}
