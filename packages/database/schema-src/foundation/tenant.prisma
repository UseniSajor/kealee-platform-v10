// ─────────────────────────────────────────────────────────────────────────────
// Tenancy — see docs/decisions/white-label-and-tenancy.md
//
// Kealee runs TWO businesses on one codebase and they must never merge:
//
//   KEALEE_DIRECT  the homeowner business. Kealee is the SERVICE PROVIDER: we
//                  produce the deliverable and we owe the duty to get it
//                  reviewed by a licensed professional.
//   WHITE_LABEL    a firm licensing the software. THEIR professionals are
//                  responsible; Kealee is the software vendor.
//
// The distinction is in the type system rather than a config flag because the
// liability models are opposites. Blending them would have Kealee inheriting
// professional responsibility for a builder's decision on a drawing Kealee
// never saw, and no contract clause repairs that after the fact.
//
// There is exactly ONE KEALEE_DIRECT tenant. It is tenant zero, and it is
// explicit rather than implicit — an implicit default is the thing that leaks.
// ─────────────────────────────────────────────────────────────────────────────

enum TenantKind {
  /// The homeowner business. Exactly one row. Kealee produces the work.
  KEALEE_DIRECT
  /// A firm licensing the platform. They produce the work.
  WHITE_LABEL
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  /// Read-only. Data is exportable; nothing new may be created.
  TERMINATED
}

/// Deployment shape, which decides what isolation guarantees apply.
enum TenantIsolation {
  /// T0: its own deployment and database. Nothing to isolate from.
  DEDICATED_DEPLOYMENT
  /// T2+: shares a database, separated by row-level security.
  SHARED_WITH_RLS
}

model Tenant {
  id              String          @id @default(cuid())
  /// URL-safe identifier. Appears in storage paths and queue job keys.
  slug            String          @unique
  name            String
  kind            TenantKind
  status          TenantStatus    @default(TRIAL)
  isolation       TenantIsolation @default(DEDICATED_DEPLOYMENT)

  // ── Branding. Configuration, never a code fork. ──
  displayName     String?
  logoUrl         String?
  primaryColor    String?
  secondaryColor  String?
  customDomain    String?         @unique
  emailFromName   String?
  emailFromAddress String?
  reportHeader    String?
  reportFooter    String?
  legalDisclaimer String?
  supportEmail    String?
  /// False hides "Powered by Kealee" for a full white-label.
  showKealeeBrand Boolean         @default(true)

  // ── Commercial ──
  /// Modules this tenant has licensed. NEVER contains homeowner SKUs —
  /// those are the KEALEE_DIRECT catalogue and are not licensable.
  enabledModules  String[]        @default([])
  planKey         String?
  /// Jurisdictions this tenant may operate in. Empty means none: the platform
  /// has ONE certified rule pack and selling into an unintegrated market is a
  /// data-layer build, not a configuration.
  jurisdictions   String[]        @default([])

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  terminatedAt    DateTime?

  usage           TenantUsage[]

  @@index([kind, status])
  @@map("tenants")
}

/// Metered usage, per tenant per period.
///
/// Recorded BEFORE any white-label tier is priced. `unit-economics.ts` carries
/// every human cost as null with a MEASURE instruction, and quoting a monthly
/// tier against unmeasured support cost is guessing.
model TenantUsage {
  id              String   @id @default(cuid())
  tenantId        String
  /// Start of the billing period this row aggregates.
  periodStart     DateTime
  periodEnd       DateTime

  aiInputTokens   BigInt   @default(0)
  aiOutputTokens  BigInt   @default(0)
  agentRuns       Int      @default(0)
  documentsCreated Int     @default(0)
  reportsGenerated Int     @default(0)
  propertiesEvaluated Int  @default(0)
  storageBytes    BigInt   @default(0)
  emailsSent      Int      @default(0)
  apiCalls        Int      @default(0)
  jobSeconds      Int      @default(0)
  /// Third-party data spend in cents — passed through, not absorbed.
  thirdPartyCents Int      @default(0)
  /// Model spend in cents, as billed by the provider.
  modelCostCents  Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodStart])
  @@index([tenantId, periodEnd])
  @@map("tenant_usage")
}
