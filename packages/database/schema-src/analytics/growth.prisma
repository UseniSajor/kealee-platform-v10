// GROWTH ANALYTICS MODELS
// Used by core-llm for growth tracking

enum AcquisitionSource {
  GOOGLE_ADS
  META_ADS
  TIKTOK
  ORGANIC
  PARTNERSHIP
  REFERRAL
  DIRECT
  OTHER
}

enum ConversionEventType {
  SIGNUP
  PAYMENT
  PROJECT_CREATED
  PROJECT_COMPLETED
  BID_SUBMITTED
  OTHER
}

model UserAcquisition {
  id          String            @id @default(uuid())
  userId      String
  source      AcquisitionSource
  medium      String?
  campaign    String?
  gclid       String?
  fbclid      String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  metadata    Json?
  timestamp   DateTime          @default(now())

  @@index([userId])
  @@index([timestamp])
  @@index([source])
}

model ConversionEvent {
  id           String              @id @default(uuid())
  userId       String
  eventType    ConversionEventType
  projectId    String?
  projectValue String?
  metadata     Json?
  timestamp    DateTime            @default(now())

  @@index([userId])
  @@index([timestamp])
  @@index([eventType])
}

model GrowthMetric {
  id               String   @id @default(uuid())
  date             DateTime @unique
  totalOwners      Int      @default(0)
  totalContractors Int      @default(0)
  newOwners        Int      @default(0)
  activeOwners     Int?     @default(0)
  totalProjects    Int?     @default(0)
  totalRevenue     Decimal? @default(0)
  averageCAC       String?
  churnRate        Float?   @default(0)
  
  @@index([date])
}

model ChannelMetrics {
  id             String   @id @default(uuid())
  channel        String   @unique
  totalUsers     Int      @default(0)
  totalSpend     Decimal  @default(0)
  cac            Decimal  @default(0)
  ltv            Decimal  @default(0)
  roi            Float    @default(0)
  conversionRate Float    @default(0)
  retentionRate  Float    @default(0)
  lastUpdated    DateTime @default(now())

  @@index([lastUpdated])
}

model FunnelMetrics {
  id                String   @id @default(uuid())
  date              DateTime
  channel           String?
  newSignups        Int      @default(0)
  intakeCompleted   Int      @default(0)
  projectsCreated   Int      @default(0)
  paymentsProcessed Int      @default(0)
  totalSpend        Decimal  @default(0)

  @@unique([date, channel])
  @@index([date])
}

model CohortAnalysis {
  id             String   @id @default(uuid())
  cohortDate     DateTime
  channel        String?
  cohortSize     Int      @default(0)
  day0Retained   Int      @default(0)
  day1Retained   Int      @default(0)
  day7Retained   Int      @default(0)
  day30Retained  Int      @default(0)
  day60Retained  Int      @default(0)
  day90Retained  Int      @default(0)
  d0Rate         Float    @default(0)
  d1Rate         Float    @default(0)
  d7Rate         Float    @default(0)
  d30Rate        Float    @default(0)
  d60Rate        Float    @default(0)
  d90Rate        Float    @default(0)

  @@unique([cohortDate, channel])
  @@index([cohortDate])
}

model PartnershipMetric {
  id                 String   @id @default(uuid())
  partnerName        String
  status             String   @default("ACTIVE")
  usersFromPartner   Int      @default(0)
  revenueFromPartner Decimal  @default(0)
  costToPartner      Decimal  @default(0)
  roi                Float    @default(0)
  integrationPoints  Int      @default(0)

  @@index([status])
}
