{
  "name": "@kealee/pascal-agents",
  "version": "1.0.0",
  "private": true,
  "description": "Versioned LLM prompt library + agent orchestrator for the Pascal Editor preconstruction stack. Pairs with @kealee/pascal-wrapper.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./prompts": {
      "types": "./src/prompts/index.ts",
      "default": "./src/prompts/index.ts"
    },
    "./agents": {
      "types": "./src/agents.ts",
      "default": "./src/agents.ts"
    },
    "./engine": {
      "types": "./src/engine.ts",
      "require": "./dist/engine.js",
      "default": "./src/engine.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kealee/pascal-wrapper": "workspace:*",
    "@tarikjabiri/dxf": "2.9.0",
    "@turf/turf": "7.4.0",
    "geotiff": "3.0.5",
    "pdfkit": "^0.20.2",
    "proj4": "2.22.0"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.13.4",
    "@types/proj4": "2.19.0",
    "polygon-clipping": "0.15.7",
    "typescript": "^5.3.3",
    "vitest": "2.1.9"
  },
  "typesVersions": {
    "*": {
      "engine": [
        "src/engine.ts"
      ],
      "prompts": [
        "src/prompts/index.ts"
      ],
      "agents": [
        "src/agents.ts"
      ]
    }
  }
}
