{
  "name": "@kealee/auth",
  "version": "1.0.0",
  "description": "Kealee Platform Authentication and Authorization Package - Clerk Identity",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./ops-api-auth": {
      "types": "./dist/ops-api-auth.d.ts",
      "import": "./dist/ops-api-auth.js",
      "require": "./dist/ops-api-auth.js",
      "default": "./dist/ops-api-auth.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@clerk/nextjs": "^5.0.0",
    "@clerk/types": "^4.0.0",
    "@kealee/database": "workspace:*",
    "@supabase/auth-helpers-nextjs": "^0.8.7",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": ">=14.0.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^18.2.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.2.0"
  }
}
