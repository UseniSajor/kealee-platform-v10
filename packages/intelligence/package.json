{
  "name": "@kealee/intelligence",
  "version": "1.0.0",
  "private": true,
  "description": "Kealee v30 intelligence layer — PropertyTwin, loop orchestration, agent output contracts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:marketing-leads": "pnpm run build && node scripts/test-marketing-leads.mjs",
    "ingest:sample-parcels": "pnpm run build && node scripts/ingest-sample-parcels.mjs --all"
  },
  "dependencies": {
    "@kealee/database": "workspace:*",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.0",
    "vitest": "^1.6.1"
  }
}
