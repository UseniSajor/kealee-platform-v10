# Portal Owner — Environment Variables
# Owner portal origin (magic links + auth callback). Production: https://owner.kealee.com
NEXT_PUBLIC_OWNER_PORTAL_URL=https://owner.kealee.com
# Public app URL for this app (NOT kealee.com). Used by pay/checkout pages.
NEXT_PUBLIC_APP_URL=http://localhost:3008
NEXT_PUBLIC_API_URL=http://localhost:3001
# web-main base URL for v30 workspace deep links (and optional iframe embed)
NEXT_PUBLIC_WEB_MAIN_URL=http://localhost:3000
# Set true to embed /workspace/:intakeId in deliverables detail (may require same-site cookies)
NEXT_PUBLIC_V30_WORKSPACE_EMBED=false
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only — magic-link generation (admin.generateLink)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
RESEND_API_KEY=re_...
# Supabase Dashboard → Auth → Redirect URLs must include:
# https://owner.kealee.com/** and /auth/callback (see docs/runbooks/owner-portal-auth-redirects.md)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (public — used for checkout session creation)
NEXT_PUBLIC_STRIPE_PRICE_DESIGN_CONCEPT_VALIDATION=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_DESIGN_ADVANCED=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_DESIGN_FULL=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_ESTIMATE_DETAILED=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_ESTIMATE_CERTIFIED=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_PERMIT_SIMPLE=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_PERMIT_PACKAGE=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_PERMIT_COORDINATION=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_PERMIT_EXPEDITING=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_PM_ADVISORY=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_PM_OVERSIGHT=price_xxx

RAILWAY_LOG_DRAIN_URL=https://http-intake.logs.datadoghq.com/...
