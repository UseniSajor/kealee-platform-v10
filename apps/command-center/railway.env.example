# Railway → kealee-platform-v10 → command-center → Variables (production)
# Copy values from apps/command-center/.env.local or run: ../../scripts/railway-sync-command-center-env.ps1

NODE_ENV=production
NEXT_PUBLIC_API_URL=https://api.kealee.com
NEXT_PUBLIC_SITE_URL=https://kealee.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Same value as web-main (Vercel) — required for marketing ops + card media + cron triggers
CRON_SECRET=
# Optional alias for admin marketing dashboard proxy
KEALEE_OPS_SECRET=
