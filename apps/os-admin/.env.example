# Copy to .env.local or run: vercel env pull .env.local --yes
# Required for build and runtime (Next.js bakes NEXT_PUBLIC_* at build time).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Kealee API (os-admin server + client calls)
NEXT_PUBLIC_API_URL=https://api.kealee.com
API_BASE_URL=https://api.kealee.com

# Optional — purchases API route
SUPABASE_SERVICE_ROLE_KEY=
