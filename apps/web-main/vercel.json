{
  "framework": "nextjs",
  "ignoreCommand": "exit 1",
  "installCommand": "cd ../.. && NODE_ENV=development pnpm install --no-frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=web-main",
  "functions": {
    "app/api/concept/generate/route.ts": { "maxDuration": 300 },
    "app/api/concept/video/route.ts":    { "maxDuration": 60 },
    "app/api/marketing/card-media/generate/route.ts": { "maxDuration": 300 },
    "app/api/webhooks/stripe/route.ts":  { "maxDuration": 30 }
  },
  "crons": [
    {
      "path": "/api/cron/marketing-drip",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/generate-weekly-campaigns",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron/send-daily-campaigns",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/linkedin",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/cron/instagram",
      "schedule": "0 16 * * 2,4,6"
    },
    {
      "path": "/api/cron/facebook",
      "schedule": "0 15 * * 1,3,5"
    },
    {
      "path": "/api/cron/twitter",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/youtube",
      "schedule": "0 15 * * 3,5"
    }
  ]
}
