{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": ["node", "react", "react-dom", "jest"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@kealee/core-rules": ["../../packages/core-rules/src/index.ts"],
      "@kealee/concept-engine": ["../../packages/concept-engine/src/index.ts"],
      "@kealee/storage": ["../../packages/storage/src/index.ts"],
      "@kealee/kealee-agent-stack": ["../../packages/kealee-agent-stack/src/index.ts"],
      "@kealee/database": ["../../packages/database/src/index.ts"],
      "@kealee/communications": ["../../packages/communications/src/index.ts"],
      "@kealee/automation/dist/*.js": ["../../packages/automation/src/*.ts"],
      "@kealee/automation/dist/*": ["../../packages/automation/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "app/api/loops", "app/api/events"]
}
