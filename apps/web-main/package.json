{
  "name": "web-main",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "lint": "next lint",
    "diag:intake": "node ./scripts/smoke-intake-diagnostics.mjs",
    "test:ghl": "node ./scripts/test-ghl-connection.mjs",
