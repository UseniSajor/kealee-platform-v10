import { NextRequest, NextResponse } from 'next/server'
import { authorizeOps, unauthorized, parseIntelligenceFilters } from '@/lib/admin/intelligence-auth'
import {
  intelligenceAdminService,
  opportunityQueryService,
  isIntelligencePersistenceAvailable,
} from '@kealee/intelligence'

export const dynamic = 'force-dynamic'

export async function GET(req: NextRequest) {
  if (!authorizeOps(req, 'read:intelligence').authorized) return unauthorized()
  if (!isIntelligencePersistenceAvailable()) {
    return NextResponse.json({ error: 'DATABASE_URL not configured' }, { status: 503 })
  }
  try {
    const filters = parseIntelligenceFilters(req)
    const [items, summary] = await Promise.all([
      intelligenceAdminService.listOpportunities(filters),
      opportunityQueryService.getDashboardSummary(filters),
    ])
    return NextResponse.json({ items, summary, count: items.length })
  } catch (err) {
    return NextResponse.json({ error: err instanceof Error ? err.message : String(err) }, { status: 500 })
  }
}
