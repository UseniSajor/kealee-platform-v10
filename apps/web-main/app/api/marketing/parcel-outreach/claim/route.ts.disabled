import { NextRequest, NextResponse } from 'next/server'
import { getSupabaseAdmin } from '@/lib/supabase-server'
import { schedulePrePaymentDrip } from '@/lib/marketing/drip-schedule'
import { launchDayForProperty } from '@/lib/marketing/five-day-launch-sequence'

export const dynamic = 'force-dynamic'

/** POST /api/marketing/parcel-outreach/claim — owner claims parcel outreach via QR/direct mail */
export async function POST(req: NextRequest) {
  try {
    const body = await req.json()
    const { token, email, phone, name } = body as {
      token?: string
      email?: string
      phone?: string
      name?: string
    }

    if (!token || !email) {
      return NextResponse.json({ error: 'token and email required' }, { status: 400 })
    }

    const supabase = getSupabaseAdmin()
    const { data: target, error } = await supabase
      .from('parcel_outreach_targets')
      .select('*')
      .eq('outreach_token', token)
      .single()

    if (error || !target) {
      return NextResponse.json({ error: 'Invalid outreach link' }, { status: 404 })
    }

    const launch = launchDayForProperty({
      lotSize: target.lot_size_sqft ?? undefined,
      yearBuilt: target.year_built ?? undefined,
      propertyType: target.property_type ?? undefined,
      zoning: target.zoning_code ? { code: target.zoning_code } : undefined,
    })

    const projectPath =
      launch?.ctaPath?.replace('/intake/', '')?.replace(/^\//, '') ?? 'exterior_concept'

    const { data: intake, error: intakeErr } = await supabase
      .from('public_intake_leads')
      .insert({
        project_path: projectPath,
        client_name: name ?? target.owner_name ?? 'Property Owner',
        contact_email: email,
        contact_phone: phone ?? target.owner_phone ?? null,
        project_address: target.address,
        source: 'parcel_outreach',
        status: 'new',
        requires_payment: true,
        payment_amount: 0,
        form_data: {
          parcelOutreachTargetId: target.id,
          zoningCode: target.zoning_code,
          recommendedProduct: launch?.recommendedProduct,
        },
        metadata: {
          funnelStage: 'lead',
          marketingSource: 'parcel_outreach',
          outreachToken: token,
        },
      })
      .select('id')
      .single()

    if (intakeErr || !intake) {
      return NextResponse.json({ error: intakeErr?.message ?? 'Intake failed' }, { status: 500 })
    }

    await supabase
      .from('parcel_outreach_targets')
      .update({
        converted_intake_id: intake.id,
        owner_email: email,
        owner_phone: phone ?? target.owner_phone,
        owner_name: name ?? target.owner_name,
        updated_at: new Date().toISOString(),
      })
      .eq('id', target.id)

    void schedulePrePaymentDrip({
      leadId: intake.id,
      email,
      name: name ?? target.owner_name,
      serviceLabel: launch?.title ?? 'Property review',
      funnelUrl: launch?.ctaPath
        ? `${process.env.NEXT_PUBLIC_SITE_URL ?? 'https://kealee.com'}${launch.ctaPath}?lead=${intake.id}`
        : `https://kealee.com/concept?lead=${intake.id}`,
    }).catch(() => {})

    return NextResponse.json({
      ok: true,
      intakeId: intake.id,
      recommendedProduct: launch?.recommendedProduct,
      landingPath: launch?.ctaPath,
    })
  } catch (err) {
    return NextResponse.json(
      { error: err instanceof Error ? err.message : String(err) },
      { status: 500 },
    )
  }
}

/** GET — lookup target for landing page */
export async function GET(req: NextRequest) {
  const token = req.nextUrl.searchParams.get('token')
  if (!token) return NextResponse.json({ error: 'token required' }, { status: 400 })

  const supabase = getSupabaseAdmin()
  const { data: target } = await supabase
    .from('parcel_outreach_targets')
    .select(
      'address, zoning_code, lot_size_sqft, year_built, recommended_product, campaign_day, jurisdiction',
    )
    .eq('outreach_token', token)
    .single()

  if (!target) return NextResponse.json({ error: 'Not found' }, { status: 404 })
  return NextResponse.json({ target })
}
