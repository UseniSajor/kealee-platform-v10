import { NextRequest, NextResponse } from 'next/server'
import {
  parcelIngestionService,
  isIntelligencePersistenceAvailable,
  SAMPLE_PARCELS,
} from '@kealee/intelligence'

export const dynamic = 'force-dynamic'

function authorize(req: NextRequest): boolean {
  const secret = process.env.KEALEE_OPS_SECRET || process.env.CRON_SECRET
  if (!secret) return false
  const auth = req.headers.get('Authorization')
  const xKealeeOps = req.headers.get('x-kealee-ops')
  return (
    (auth != null && auth === `Bearer ${secret}`) ||
    (xKealeeOps != null && xKealeeOps === secret)
  )
}

/**
 * POST /api/intelligence/ingest-parcel
 * Sample parcel ingestion for Phase 2 — requires CRON_SECRET or KEALEE_OPS_SECRET.
 *
 * Body: { address?, parcelId?, sample?: boolean, all?: boolean }
 */
export async function POST(req: NextRequest) {
  if (!authorize(req)) {
    return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
  }

  if (!isIntelligencePersistenceAvailable()) {
    return NextResponse.json(
      { error: 'DATABASE_URL not configured for intelligence persistence' },
      { status: 503 },
    )
  }

  try {
    const body = await req.json().catch(() => ({}))

    if (body.all === true) {
      const results = await parcelIngestionService.ingestAllSamples()
      return NextResponse.json({
        ingested: results.length,
        propertyTwinIds: results.map((r) => r.propertyTwin.id),
      })
    }

    if (body.sample === true || (!body.address && !body.parcelId)) {
      const sample =
        SAMPLE_PARCELS.find((p) => p.parcelId === body.parcelId) ?? SAMPLE_PARCELS[0]
      const result = await parcelIngestionService.ingestSample(sample)
      return NextResponse.json(result)
    }

    const result = await parcelIngestionService.ingest({
      address: String(body.address),
      parcelId: body.parcelId ? String(body.parcelId) : undefined,
      jurisdiction: body.jurisdiction ? String(body.jurisdiction) : undefined,
      propertyType: body.propertyType ? String(body.propertyType) : undefined,
      triggerEventId: body.triggerEventId ? String(body.triggerEventId) : undefined,
    })

    return NextResponse.json(result)
  } catch (err) {
    console.error('[ingest-parcel]', err)
    return NextResponse.json(
      { error: err instanceof Error ? err.message : String(err) },
      { status: 500 },
    )
  }
}

export async function GET(req: NextRequest) {
  return POST(req)
}
