{
  "name": "@kealee/api-enterprise-bots",
  "version": "1.0.0",
  "private": true,
  "description": "Kealee API server — AI bots, growth metrics, and admin endpoints",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node --esm src/server.ts",
    "dev:watch": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@kealee/core-llm": "workspace:*",
    "@kealee/database": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
