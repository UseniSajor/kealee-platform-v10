# ============================================================
# Kealee v30 Portal Admin — Environment Variables
# Copy to .env.local for local development
# ============================================================

# Password that protects the admin portal
# Dev default (matches PORTAL_ADMIN_SECRET in middleware check):
PORTAL_ADMIN_PASSWORD=kealee-admin-dev
PORTAL_ADMIN_SECRET=kealee-admin-dev

# Internal URL of the Kealee API service
# Local: http://localhost:3001
# Railway/production: set to your internal Railway private URL or https://api.kealee.com
INTERNAL_API_URL=http://localhost:3001

# Optional — only needed if INTERNAL_API_URL is not set
# NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================================
# Access
#   Local:      http://localhost:3020/login
#   Production: set PORTAL_ADMIN_PASSWORD to a strong secret in
#               Vercel / Railway — do NOT use the dev default.
# ============================================================
