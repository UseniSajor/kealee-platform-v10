# Canonical Kealee platform lead endpoint.
# Use the full URL when the marketing app and web-main are deployed separately.
PLATFORM_LEAD_API_URL=https://kealee.com/api/leads/marketing

# Optional alternative used to construct /api/leads/marketing.
PLATFORM_WEB_URL=https://kealee.com

# Must match MARKETING_BOT_API_KEY on web-main when endpoint auth is enabled.
MARKETING_BOT_API_KEY=

# Environment
NODE_ENV=development
