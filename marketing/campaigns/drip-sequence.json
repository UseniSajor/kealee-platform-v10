{
  "id": "drip-sequence-v1",
  "version": "1.1.0",
  "title": "Resend nurture drip (no GHL)",
  "updatedAt": "2026-05-24",
  "canonicalUpsell": "../upsell-path.json",
  "provider": "resend",
  "queueTable": "marketing_drip_queue",
  "cron": "/api/cron/marketing-drip",
  "steps": [
    { "step": 0, "trigger": "lead_created", "delayDays": 0, "template": "welcome" },
    { "step": 1, "delayDays": 1, "template": "package_included" },
    { "step": 2, "delayDays": 3, "template": "social_proof" },
    { "step": 3, "delayDays": 7, "template": "final_cta" },
    {
      "step": 4,
      "delayDays": 14,
      "template": "permit_upsell",
      "when": "concept_ready",
      "path": "/intake/permit_path_only",
      "legacyTemplate": "estimate_upsell"
    },
    {
      "step": 5,
      "delayDays": 21,
      "template": "drawings_upsell",
      "when": "concept_ready",
      "path": "/intake/professional_drawings"
    }
  ],
  "lifecycleEmails": [
    { "id": "post-payment", "trigger": "stripe_paid" },
    { "id": "concept-ready", "trigger": "concept_ready", "module": "lifecycle.ts", "nextUpsell": "permit" }
  ]
}
